<Window x:Class="QuickTranslator.AiEditor.Wpf.ProjectTranslationQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QT Studio · Hàng đợi dịch" Width="1120" Height="760" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  </Window.Resources>
  <Grid Margin="14" TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="4,0,4,10" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left"><TextBlock x:Name="HeadingText" Text="Tiến độ dịch" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="ProjectText" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Width="470"><TextBlock x:Name="SummaryText" HorizontalAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Có thể đóng cửa sổ này; hàng đợi vẫn lưu tiến độ sau từng đoạn." HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
    </DockPanel>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,9">
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="TỔNG" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="TotalMetricText" Text="0" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="HOÀN THÀNH" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="CompletedMetricText" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ĐANG DỊCH" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="RunningMetricText" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Margin="0"><StackPanel><TextBlock Text="CÒN LẠI" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="RemainingMetricText" Text="0" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
    </UniformGrid>
    <ItemsControl x:Name="WorkerCards" Grid.Row="2" Margin="0,0,0,8">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,8,0"><StackPanel><DockPanel LastChildFill="False"><TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}"/></DockPanel><TextBlock Text="{Binding Model}" Foreground="{DynamicResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CurrentChapterTitle, TargetNullValue=Đang chờ chương}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{DynamicResource MutedBrush}"><Run Text="{Binding HanCharactersPerMinute, StringFormat={}{0:N0}}"/><Run Text=" chữ Hán/phút · "/><Run Text="{Binding CompletedSegments}"/><Run Text="/"/><Run Text="{Binding TotalSegments}"/><Run Text=" đoạn"/></TextBlock></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Grid.Row="3" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><ProgressBar x:Name="ChapterProgress" Height="10" Minimum="0" Maximum="100" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource EditorSurfaceBrush}"/><TextBlock x:Name="CurrentText" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
      <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top"><Button x:Name="StartButton" Content="Dịch" Style="{StaticResource PrimaryButton}" Click="OnStart"/><Button x:Name="PauseButton" Content="Tạm dừng" Click="OnPause" ToolTip="Tạm dừng sau khi AI xử lý xong đoạn hiện tại"/><Button x:Name="ResumeButton" Content="Tiếp tục" Style="{StaticResource PrimaryButton}" Click="OnResume"/><Button x:Name="CancelButton" Content="Dừng nhanh" Click="OnCancel" ToolTip="Dừng request hiện tại; các đoạn đã lưu được giữ lại"/></WrapPanel>
    </Grid>
    <DockPanel Grid.Row="4" Margin="0,0,0,8">
      <Expander x:Name="TechnicalExpander" Header="Chi tiết cấu hình &amp; chẩn đoán" Foreground="{DynamicResource MutedBrush}">
        <StackPanel><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,5,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GPU" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="BackendText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Model" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ModelText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Prompt" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="PromptText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Phiên tài nguyên" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ResourceText" FontWeight="SemiBold"/></StackPanel></Grid></Border><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,5,8,0"><StackPanel><TextBlock Text="Chapter đang chọn" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="SelectedDiagnosticText" Text="{Binding ElementName=QueueGrid, Path=SelectedItem.Error}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
      </Expander>
      <Expander x:Name="TroubleExpander" DockPanel.Dock="Right" Header="Xử lý sự cố" Foreground="{DynamicResource MutedBrush}"><WrapPanel Margin="0,5,0,0"><Button x:Name="RetryButton" Content="Thử lại chương lỗi" Click="OnRetry"/><Button x:Name="ReplanButton" Content="Kiểm tra nguồn thay đổi" Click="OnReplan"/><Button x:Name="RetryWorkerButton" Content="Kết nối lại GPU" Click="OnRetryWorker"/><Button x:Name="ReassignButton" Content="Chuyển phần chưa dịch" Click="OnReassignPending"/></WrapPanel></Expander>
    </DockPanel>
    <DataGrid x:Name="QueueGrid" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource PanelAltBrush}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" MouseDoubleClick="OnQueueGridDoubleClick" ToolTip="Nhấp đúp một chương đã xử lý để mở trong Editor">
      <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Order}" Width="55"/><DataGridTextColumn Header="Số" Binding="{Binding Number}" Width="65"/><DataGridTextColumn Header="Chương" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="GPU" Binding="{Binding Worker}" Width="125"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="155"/><DataGridTextColumn Header="Đoạn" Binding="{Binding SegmentLabel}" Width="105"/><DataGridTextColumn Header="Chi tiết" Binding="{Binding Error}" Width="2*"/></DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,8,0,0"><TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></Border>
  </Grid>
</Window>
