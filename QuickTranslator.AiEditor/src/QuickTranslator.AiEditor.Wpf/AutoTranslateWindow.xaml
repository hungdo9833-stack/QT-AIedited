<Window x:Class="QuickTranslator.AiEditor.Wpf.AutoTranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tự động dịch từ link" Width="1020" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Closing="OnWindowClosing"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDropFiles" ResizeMode="CanResize">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Overlay}"/><Setter Property="Padding" Value="12"/></Style>
 </Window.Resources>
 <Grid Margin="{StaticResource Inset.Window}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}">
   <StackPanel>
    <TextBlock Text="Tự động dịch từ link" Style="{StaticResource WindowTitle}"/>
    <TextBlock Style="{StaticResource WindowSubtitle}" Text="Mỗi dòng một link mục lục truyện. Mỗi truyện được tải về, tạo dự án mới, Codex khảo sát nhân vật và từ điển, rồi dịch toàn bộ bằng backend đang chọn trong QT Studio. Khi đang chạy vẫn dán thêm link được; truyện bị dừng thì bấm Thử lại ở dòng của nó. File TXT: bấm Thêm file TXT, kéo thả vào cửa sổ hoặc dán đường dẫn file." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBox x:Name="LinksInput" AcceptsReturn="True" TextWrapping="NoWrap" Height="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Danh sách link truyện, mỗi dòng một link"/>
    <WrapPanel Margin="0,8,0,0">
     <TextBlock Text="Model Codex" VerticalAlignment="Center" Margin="4"/>
     <TextBox x:Name="ModelInput" Text="gpt-6-luna" Width="140" AutomationProperties.Name="Model Codex"/>
     <TextBlock Text="Effort" VerticalAlignment="Center" Margin="12,4,4,4"/>
     <ComboBox x:Name="EffortInput" Width="100" SelectedIndex="2" AutomationProperties.Name="Mức suy luận của Codex">
      <ComboBoxItem Content="low"/><ComboBoxItem Content="medium"/><ComboBoxItem Content="high"/><ComboBoxItem Content="xhigh"/>
     </ComboBox>
     <TextBlock Text="Workspace" VerticalAlignment="Center" Margin="12,4,4,4"/>
     <ComboBox x:Name="WorkspaceInput" Width="110" SelectedIndex="0" AutomationProperties.Name="Workspace Codex">
      <ComboBoxItem Content="business"/><ComboBoxItem Content="personal"/>
     </ComboBox>
     <TextBlock Text="Nghỉ giữa các yêu cầu (giây)" VerticalAlignment="Center" Margin="12,4,4,4"/>
     <TextBox x:Name="DelayInput" Text="1.5" Width="60" AutomationProperties.Name="Thời gian nghỉ giữa các yêu cầu tải web"/>
     <Button Content="Thêm file TXT…" Click="OnAddTxtFiles" Margin="12,4,4,4" Padding="10,2"
             ToolTip="Chọn một hoặc nhiều file TXT truyện tiếng Trung (hoặc kéo thả file vào cửa sổ). Truyện từ file bỏ qua bước tải."
             AutomationProperties.Name="Thêm file TXT vào hàng chờ"/>
     <CheckBox x:Name="PrepareOnlyCheck" Content="Chỉ chuẩn bị (tải + khảo sát), chưa dịch" VerticalAlignment="Center" Margin="12,4,4,4"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12">
   <DataGrid x:Name="BookGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" AutomationProperties.Name="Tiến độ từng truyện">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Truyện" Binding="{Binding Title}" Width="2*"/>
     <DataGridTextColumn Header="Bước" Binding="{Binding Stage}" Width="*"/>
     <DataGridTextColumn Header="Chi tiết" Binding="{Binding Detail}" Width="3*">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTemplateColumn Header="Thao tác" Width="130" MinWidth="130" DisplayIndex="1">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <StackPanel Orientation="Horizontal">
         <Button Content="Thử lại" Click="OnRetryRow" IsEnabled="{Binding CanRetry}" Padding="8,2" Margin="2"
                 ToolTip="Chạy tiếp truyện này từ bước đã dừng (tải tiếp, khảo sát hoặc dịch)" AutomationProperties.Name="Thử lại truyện này"/>
         <Button Content="Bỏ" Click="OnRemoveRow" Padding="8,2" Margin="2"
                 ToolTip="Bỏ truyện này khỏi hàng chờ (đang dịch thì hàng đợi được tạm dừng)" AutomationProperties.Name="Bỏ truyện này khỏi hàng chờ"/>
        </StackPanel>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="StopButton" Content="Dừng" Click="OnStop" IsEnabled="False"/>
     <Button x:Name="CloseButton" IsCancel="True" Content="Đóng" Click="OnClose"/>
     <Button x:Name="StartButton" Content="Bắt đầu" Style="{StaticResource PrimaryButton}" Click="OnStart"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" Text="Dán link rồi bấm Bắt đầu." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4" AutomationProperties.LiveSetting="Polite"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
