<Window x:Class="QuickTranslator.AiEditor.Wpf.GpuManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QT Studio · GPU Manager" Width="1040" Height="720" MinWidth="860" MinHeight="620"
 WindowStartupLocation="CenterOwner">
 <Grid Margin="14" TextElement.Foreground="{DynamicResource TextBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Margin="0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
     <Button Content="＋ Thêm GPU Remote" Click="OnNewProfile" Style="{StaticResource PrimaryButton}"/>
     <Button Content="Xóa profile" Click="OnDeleteProfile" Style="{StaticResource DangerButton}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="GPU PROFILES" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Local và máy GPU thuê" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,10"/></StackPanel>
    <ListBox x:Name="ProfileList" DisplayMemberPath="Name" SelectionChanged="OnProfileSelected"/>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Lưu profile" Click="OnSaveProfile"/><Button Content="Kết nối" Click="OnConnect" Style="{StaticResource PrimaryButton}"/><Button Content="Ngắt" Click="OnDisconnect"/></StackPanel><StackPanel><TextBlock Text="GPU Connection Manager" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Chọn một profile để cấu hình." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></DockPanel>
    <Border Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="Dùng profile đang chọn cho Remote" Click="OnUseForRemote"/><StackPanel><TextBlock Text="CHẾ ĐỘ DỊCH" FontWeight="SemiBold"/><ComboBox x:Name="TranslationModeInput" Width="290" HorizontalAlignment="Left" SelectionChanged="OnTranslationModeChanged"><ComboBoxItem Content="Local Only"/><ComboBoxItem Content="Remote Only"/><ComboBoxItem Content="Parallel · Local + Remote"/></ComboBox><TextBlock x:Name="TranslationModeText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0"><TextBlock Text="Tên máy chủ" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameInput"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Model Ollama" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ModelInput" Text="translategemma:12b"/></StackPanel>
     </Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0"><TextBlock Text="SSH Host / IP" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HostInput"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Port" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PortInput" Text="22"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Username" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UsernameInput" Text="ubuntu"/></StackPanel>
     </Grid>
     <TextBlock Text="Xác thực" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="AuthenticationInput" SelectedIndex="0" SelectionChanged="OnAuthenticationChanged"><ComboBoxItem Content="Password"/><ComboBoxItem Content="SSH Private Key"/></ComboBox>
     <StackPanel x:Name="PasswordPanel"><TextBlock Text="SSH password" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="PasswordInput" PasswordChar="●"/></StackPanel>
     <StackPanel x:Name="PrivateKeyPanel" Visibility="Collapsed"><TextBlock Text="SSH private key" Style="{StaticResource FieldLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="Chọn file key…" Click="OnChoosePrivateKey"/><PasswordBox x:Name="PrivateKeyInput" PasswordChar="●"/><PasswordBox x:Name="PrivateKeyPassphraseInput" PasswordChar="●" ToolTip="Passphrase của private key (nếu có)"/></DockPanel></StackPanel>
     <TextBlock Text="SSH host-key fingerprint" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FingerprintInput" ToolTip="Đối chiếu SHA256 fingerprint bằng kênh độc lập trước khi lưu."/>
     <TextBlock Text="QT Studio luôn chặn host key mới hoặc đã thay đổi. Fingerprint quan sát được phải được đối chiếu ngoài băng trước khi tin cậy." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="3,5"/>
     <Expander Header="Thiết lập nâng cao" Margin="3,8"><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Ollama port trên server" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RemoteOllamaPortInput" Text="11434"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Giá thuê / giờ (ước tính)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HourlyPriceInput" Text="0"/></StackPanel></Grid></Expander>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="Kiểm tra server" Click="OnInspect"/><TextBlock Text="SERVER &amp; OLLAMA" FontWeight="SemiBold"/></DockPanel>
     <TextBlock x:Name="InspectionText" Text="Chưa kiểm tra." TextWrapping="Wrap" Margin="3,9" Foreground="{DynamicResource MutedBrush}"/>
     <WrapPanel><Button Content="Cài Ollama (Ubuntu)" Click="OnInstallOllama"/><Button Content="Khởi động Ollama" Click="OnStartOllama"/><Button Content="Tải model" Click="OnPullModel"/><Button x:Name="CancelSetupButton" Content="Hủy thao tác" Click="OnCancelSetup" IsEnabled="False"/></WrapPanel>
     <ProgressBar x:Name="ModelPullProgress" Height="7" Margin="3,8,3,2" Minimum="0" Maximum="100" Visibility="Collapsed"/>
     <TextBlock Text="Cài đặt/start chỉ chạy sau xác nhận riêng. QT Studio không cài driver NVIDIA và không truyền sudo password qua shell." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="3,6"/>
    </StackPanel></Border>
    <TextBlock Text="Chi phí hiển thị trong QT Studio chỉ là ước tính. Ngắt SSH hoặc Ollama không đồng nghĩa nhà cung cấp ngừng tính phí." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="5"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
