<Window x:Class="QuickTranslator.AiEditor.Wpf.GpuManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:QuickTranslator.AiEditor.Wpf"
 Title="QT Studio · AI &amp; hiệu năng" Width="1180" Height="820" MinWidth="820" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="16" TextElement.Foreground="{DynamicResource TextBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Margin="0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
     <Button Content="Thêm GPU Remote" Click="OnNewProfile" ui:ButtonIcon.Glyph="&#xE710;"/>
     <Button Content="Xóa profile" Click="OnDeleteProfile" Style="{StaticResource DangerButton}" ui:ButtonIcon.Glyph="&#xE74D;"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="DANH SÁCH GPU" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock Text="AI &amp; hiệu năng" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,4"/>
     <TextBlock Text="Chọn GPU để xem model và trạng thái kết nối." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    </StackPanel>
    <ListBox x:Name="ProfileList" SelectionChanged="OnProfileSelected" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Danh sách GPU">
     <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="1,3"><StackPanel>
      <DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/></DockPanel>
      <TextBlock Text="{Binding Runtime.ModelOptions.Model}" Foreground="{DynamicResource AccentTextBrush}" TextTrimming="CharacterEllipsis"/>
     </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <DockPanel Margin="0,0,0,10">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button x:Name="SaveProfileButton" Content="Lưu cấu hình GPU" Click="OnSaveProfile" Style="{StaticResource PrimaryButton}" ui:ButtonIcon.Glyph="&#xE74E;"/>
      <Button Content="Kiểm tra / Kết nối" Click="OnConnect" ui:ButtonIcon.Glyph="&#xE72C;"/><Button Content="Ngắt" Click="OnDisconnect"/>
     </StackPanel>
     <StackPanel><TextBlock Text="Thiết lập AI &amp; hiệu năng" Style="{StaticResource WindowTitle}"/><TextBlock x:Name="StatusText" Text="Chọn một GPU profile." Style="{StaticResource WindowSubtitle}" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    </DockPanel>
    <Border Style="{StaticResource Card}"><DockPanel>
     <Button x:Name="UseForRemoteButton" DockPanel.Dock="Right" Content="Dùng card này cho Remote" Click="OnUseForRemote"/>
     <StackPanel><TextBlock Text="CHẾ ĐỘ DỊCH" FontWeight="SemiBold"/><ComboBox x:Name="TranslationModeInput" Width="310" HorizontalAlignment="Left" SelectionChanged="OnTranslationModeChanged"><ComboBoxItem Content="Chỉ GPU máy này"/><ComboBoxItem Content="Chỉ GPU từ xa"/><ComboBoxItem Content="Song song · Máy này + Từ xa"/></ComboBox><TextBlock x:Name="TranslationModeText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    </DockPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="CẤU HÌNH GPU ĐANG CHỌN" FontWeight="SemiBold"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0"><TextBlock Text="Tên hiển thị" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameInput"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock x:Name="ModelLabel" Text="Model llama-server" Style="{StaticResource FieldLabel}"/><DockPanel><Button x:Name="ChooseGgufButton" DockPanel.Dock="Right" Content="Chọn file .gguf…" Click="OnChooseGguf" Visibility="Collapsed"/><TextBox x:Name="ModelInput" Text="IndexTeam/Index-Translate-9B-GGUF:Q4_K_M"/></DockPanel></StackPanel>
     </Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1"><TextBlock Text="Số request song song" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ParallelRequestsInput" Text="4" ToolTip="Từ 1 đến 8"/></StackPanel>
     </Grid>
      <Expander x:Name="AdvancedRuntimeExpander" Header="Thiết lập nâng cao · context, đầu ra và cỡ đoạn" IsExpanded="False" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}">
       <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,7,0"><TextBlock Text="Temperature" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RuntimeTemperatureInput" Text="0.1"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="0,0,7,0"><TextBlock Text="Context" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RuntimeContextInput" Text="4096"/></StackPanel>
         <StackPanel Grid.Column="2" Margin="0,0,7,0"><TextBlock Text="Độ dài đầu ra" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RuntimeOutputInput" Text="2048"/></StackPanel>
         <StackPanel Grid.Column="3"><TextBlock Text="Thời gian chờ (giây)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RuntimeTimeoutInput" Text="300"/></StackPanel>
        </Grid>
        <TextBlock Text="Độ dài đoạn tiếng Trung cho GPU này" Style="{StaticResource FieldLabel}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,7,0"><TextBlock Text="Tối thiểu" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RuntimeMinimumInput" Text="300"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="0,0,7,0"><TextBlock Text="Mục tiêu" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RuntimeTargetInput" Text="400"/></StackPanel>
         <StackPanel Grid.Column="2" Margin="0,0,7,0"><TextBlock Text="Tối đa" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RuntimeMaximumInput" Text="500"/></StackPanel>
         <StackPanel Grid.Column="3"><TextBlock Text="Ký tự tối đa" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RuntimeTextElementsInput" Text="2000"/></StackPanel>
        </Grid>
       </StackPanel>
      </Expander>
    </StackPanel></Border>
     <Expander x:Name="AdvancedConnectionExpander" Header="Thông tin máy thuê · địa chỉ, tài khoản, mật khẩu (SSH / HTTPS / token)" IsExpanded="False" Margin="3,7" Foreground="{DynamicResource MutedBrush}">
     <Border Style="{StaticResource Card}" Margin="0,5,0,0"><StackPanel>
      <TextBlock Text="Loại kết nối Remote" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ConnectionTypeInput" SelectionChanged="OnConnectionTypeChanged"><ComboBoxItem Content="SSH tunnel (khuyên dùng)"/><ComboBoxItem Content="HTTPS / private network trực tiếp"/></ComboBox>
      <StackPanel x:Name="DirectConnectionPanel" Visibility="Collapsed">
       <TextBlock Text="llama-server endpoint" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EndpointInput" Text="https://"/>
       <TextBlock Text="Bearer token" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="TokenInput" PasswordChar="●"/>
       <TextBlock Text="Direct Remote chỉ chấp nhận HTTPS hợp lệ hoặc HTTP trên địa chỉ private/loopback. QT Studio không bỏ qua lỗi chứng chỉ." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel x:Name="SshConnectionPanel">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="SSH Host / IP" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HostInput"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Port" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PortInput" Text="22"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Username" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UsernameInput" Text="ubuntu"/></StackPanel>
       </Grid>
       <TextBlock Text="Xác thực" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="AuthenticationInput" SelectedIndex="0" SelectionChanged="OnAuthenticationChanged"><ComboBoxItem Content="Password"/><ComboBoxItem Content="SSH Private Key"/></ComboBox>
       <StackPanel x:Name="PasswordPanel"><TextBlock Text="SSH password" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="PasswordInput" PasswordChar="●"/></StackPanel>
       <StackPanel x:Name="PrivateKeyPanel" Visibility="Collapsed"><TextBlock Text="SSH private key" Style="{StaticResource FieldLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="Chọn file key…" Click="OnChoosePrivateKey"/><PasswordBox x:Name="PrivateKeyInput" PasswordChar="●"/><PasswordBox x:Name="PrivateKeyPassphraseInput" PasswordChar="●" ToolTip="Passphrase của private key (nếu có)" AutomationProperties.Name="Passphrase của private key" AutomationProperties.HelpText="Passphrase của private key (nếu có)"/></DockPanel></StackPanel>
       <TextBlock Text="SSH host-key fingerprint" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FingerprintInput" ToolTip="Đối chiếu SHA256 fingerprint bằng kênh độc lập trước khi lưu."/>
       <TextBlock Text="QT Studio chặn host key mới hoặc đã thay đổi cho tới khi fingerprint được xác minh." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="3,5"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="llama-server port" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ServerPortInput" Text="11434"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Giá thuê / giờ (ước tính)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HourlyPriceInput" Text="0"/></StackPanel></Grid>
      </StackPanel>
     </StackPanel></Border>
    </Expander>
    <Border Style="{StaticResource Card}"><StackPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="Kiểm tra server" Click="OnInspect"/><TextBlock Text="TRẠNG THÁI &amp; CÔNG CỤ" FontWeight="SemiBold"/></DockPanel>
     <TextBlock x:Name="InspectionText" Text="Chưa kiểm tra." TextWrapping="Wrap" Margin="3,9" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock Text="Dùng model, số luồng và context trong cấu hình GPU đang chọn." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="3,7"/>
     <WrapPanel Margin="0,0,0,6"><Button x:Name="AutoSetupButton" Content="Tự nhận diện &amp; cài llama-server" Click="OnAutoSetup" Style="{StaticResource PrimaryButton}" ui:ButtonIcon.Glyph="&#xE713;" ToolTip="Chỉ hỗ trợ máy thuê Windows; tải llama.cpp từ máy này, không cài driver NVIDIA."/><Button x:Name="ImportRdpButton" Content="Nhập file RDP…" Click="OnImportRdp" ui:ButtonIcon.Glyph="&#xE8E5;" ToolTip="Lấy IP, cổng và tên đăng nhập từ file .rdp mà nhà cho thuê Windows gửi. Mật khẩu trong file không được đọc."/></WrapPanel>
     <WrapPanel><Button x:Name="StartServerButton" Content="Khởi động lại llama-server" Click="OnStartServer" ui:ButtonIcon.Glyph="&#xE768;"/><Button x:Name="PullModelButton" Content="Áp dụng model/luồng" Click="OnPullModel" ui:ButtonIcon.Glyph="&#xE8B5;"/><Button x:Name="CancelSetupButton" Content="Hủy thao tác" Click="OnCancelSetup" IsEnabled="False"/></WrapPanel>
     <ProgressBar x:Name="ModelPullProgress" Height="7" Margin="3,8,3,2" Minimum="0" Maximum="100" Visibility="Collapsed"/>
     <TextBlock Text="Sẵn sàng chỉ hiển thị sau khi /health và /v1/models phản hồi qua SSH tunnel; kiểm tra server không phải benchmark suy luận." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="3,6"/>
    </StackPanel></Border>
    <TextBlock Text="Chi phí chỉ là ước tính. Ngắt SSH hoặc llama-server không đồng nghĩa nhà cung cấp ngừng tính phí." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="5"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
