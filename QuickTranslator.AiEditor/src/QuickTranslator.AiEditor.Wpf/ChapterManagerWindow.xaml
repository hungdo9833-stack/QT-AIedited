<Window x:Class="QuickTranslator.AiEditor.Wpf.ChapterManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QT Studio · Chapter Manager" Width="1320" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#07111F" Foreground="#E8EEF7">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#0E1B2D"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#12243A"/>
    <SolidColorBrush x:Key="Border" Color="#263D59"/>
    <SolidColorBrush x:Key="Muted" Color="#91A4BC"/>
    <SolidColorBrush x:Key="Accent" Color="#2F80ED"/>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="#0A1626"/><Setter Property="Foreground" Value="#E8EEF7"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7,6"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="{StaticResource PanelAlt}"/><Setter Property="Foreground" Value="#E8EEF7"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="4,0,4,8">
      <StackPanel>
        <TextBlock Text="Quản lý chương" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock x:Name="ProjectTitleText" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
        <TextBlock x:Name="CatalogCountText" HorizontalAlignment="Right" FontWeight="SemiBold"/>
        <TextBlock Text="Catalog đọc metadata từ manifest; không nạp nội dung chương." Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchInput" ToolTip="Tìm theo số, tên Việt hoặc tên Trung" TextChanged="OnFilterChanged"/>
        <ComboBox x:Name="VolumeFilter" Grid.Column="1" SelectionChanged="OnFilterChanged"><ComboBoxItem Tag="" IsSelected="True">Tất cả quyển</ComboBoxItem></ComboBox>
        <ComboBox x:Name="StateFilter" Grid.Column="2" SelectionChanged="OnFilterChanged">
          <ComboBoxItem Tag="" IsSelected="True">Tất cả trạng thái dịch</ComboBoxItem><ComboBoxItem Tag="Untranslated">Chưa dịch</ComboBoxItem><ComboBoxItem Tag="Translating">Đang dịch</ComboBoxItem><ComboBoxItem Tag="AwaitingReview">Chờ duyệt</ComboBoxItem><ComboBoxItem Tag="NeedsInspection">Cần kiểm tra</ComboBoxItem><ComboBoxItem Tag="Approved">Đã duyệt</ComboBoxItem><ComboBoxItem Tag="Error">Lỗi</ComboBoxItem>
        </ComboBox>
        <ComboBox x:Name="ApprovalFilter" Grid.Column="3" SelectionChanged="OnFilterChanged">
          <ComboBoxItem Tag="All" IsSelected="True">Tất cả duyệt</ComboBoxItem><ComboBoxItem Tag="NotApproved">Chưa duyệt xong</ComboBoxItem><ComboBoxItem Tag="Approved">Đã duyệt</ComboBoxItem>
        </ComboBox>
        <ComboBox x:Name="DeletionFilter" Grid.Column="4" SelectionChanged="OnFilterChanged">
          <ComboBoxItem Tag="Active" IsSelected="True">Đang hoạt động</ComboBoxItem><ComboBoxItem Tag="Deleted">Trong History</ComboBoxItem><ComboBoxItem Tag="All">Tất cả</ComboBoxItem>
        </ComboBox>
        <ComboBox x:Name="SortInput" Grid.Column="5" SelectionChanged="OnFilterChanged">
          <ComboBoxItem Tag="ReadingOrder" IsSelected="True">Thứ tự đọc</ComboBoxItem><ComboBoxItem Tag="Number">Số chương</ComboBoxItem><ComboBoxItem Tag="Title">Tên chương</ComboBoxItem><ComboBoxItem Tag="Updated">Mới sửa trước</ComboBoxItem>
        </ComboBox>
      </Grid>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,8">
      <WrapPanel>
        <Button x:Name="OpenButton" Content="Mở trong Editor" Style="{StaticResource PrimaryButton}" Click="OnOpen"/>
        <Button x:Name="RenameButton" Content="Đổi tên" Click="OnRename"/>
        <Button x:Name="DeleteButton" Content="Chuyển vào History" Click="OnDelete"/>
        <Button x:Name="RestoreButton" Content="Phục hồi" Click="OnRestore"/>
        <Button x:Name="QueueButton" Content="Dịch các chương đã chọn · M4" IsEnabled="False" ToolTip="Command surface đã sẵn sàng; Translation Queue được triển khai ở M4."/>
      </WrapPanel>
      <TextBlock x:Name="SelectionText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
    </DockPanel>
    <DataGrid x:Name="ChapterGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
              CanUserSortColumns="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              Background="{StaticResource Panel}" Foreground="#E8EEF7" BorderBrush="{StaticResource Border}" RowBackground="#0E1B2D" AlternatingRowBackground="#102036"
              EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
              SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnGridDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding DisplayOrder}" SortMemberPath="DisplayOrder" Width="62"/>
        <DataGridTextColumn Header="Số gốc" Binding="{Binding Number}" SortMemberPath="Number" Width="78"/>
        <DataGridTextColumn Header="Tên chương" Binding="{Binding VietnameseTitle}" SortMemberPath="VietnameseTitle" Width="2*"/>
        <DataGridTextColumn Header="Tên Trung" Binding="{Binding ChineseTitle}" SortMemberPath="ChineseTitle" Width="1.5*"/>
        <DataGridTextColumn Header="Quyển" Binding="{Binding VolumeLabel}" SortMemberPath="VolumeLabel" Width="130"/>
        <DataGridTextColumn Header="Dịch" Binding="{Binding TranslationLabel}" SortMemberPath="TranslationState" Width="115"/>
        <DataGridTextColumn Header="Duyệt" Binding="{Binding ApprovalLabel}" SortMemberPath="ApprovalState" Width="115"/>
        <DataGridTextColumn Header="Tiến độ" Binding="{Binding ProgressLabel}" Width="90"/>
        <DataGridTextColumn Header="Cập nhật" Binding="{Binding UpdatedLabel}" SortMemberPath="UpdatedAt" Width="135"/>
        <DataGridTextColumn Header="Lưu trữ" Binding="{Binding DeletedLabel}" SortMemberPath="IsDeleted" Width="105"/>
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,8,0,0">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    </Border>
  </Grid>
</Window>
