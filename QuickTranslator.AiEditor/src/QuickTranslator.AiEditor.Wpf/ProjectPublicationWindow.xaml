<Window x:Class="QuickTranslator.AiEditor.Wpf.ProjectPublicationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QT Studio · Xuất bản" Width="760" Height="570" MinWidth="650" MinHeight="520"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
 Foreground="{DynamicResource TextBrush}" Loaded="OnLoaded" Closing="OnClosing">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="2,0,2,14"><TextBlock Text="Xuất bản toàn bộ truyện" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Ghép các chương đang hoạt động theo thứ tự đọc thành một file TXT hoặc PDF." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="PROJECT" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ProjectTitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="CHƯƠNG SẼ XUẤT" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ChapterCountText" Text="Đang kiểm tra…" FontSize="17" FontWeight="SemiBold"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="TRẠNG THÁI" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="InspectionText" Text="Đang đọc metadata và bản dịch…" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
  </Grid></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Định dạng" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FormatInput" SelectionChanged="OnFormatChanged"><ComboBoxItem Tag="Txt" IsSelected="True">TXT · UTF-8</ComboBoxItem><ComboBoxItem Tag="Pdf">PDF · A4</ComboBoxItem></ComboBox></StackPanel>
   <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Nội dung" Style="{StaticResource FieldLabel}"/><CheckBox x:Name="IncludeProjectTitleInput" Content="Gồm tên Project" IsChecked="True"/><CheckBox x:Name="IncludeChapterTitlesInput" Content="Gồm tiêu đề từng chương" IsChecked="True"/><CheckBox x:Name="AllowIncompleteInput" Content="Cho phép xuất bản nháp/chương cần kiểm tra" Visibility="Collapsed" Checked="OnAllowIncompleteChanged" Unchecked="OnAllowIncompleteChanged" Foreground="{DynamicResource WarningBrush}"/></StackPanel>
  </Grid></Border>
  <Border Grid.Row="3" Style="{StaticResource Card}"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="FormatDescriptionText" Text="TXT giữ nguyên nội dung tiếng Việt do Reader và trình xuất chương đang sử dụng." TextWrapping="Wrap"/><ProgressBar x:Name="ExportProgress" Height="7" Minimum="0" Maximum="1" Margin="4,18,4,6" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource EditorSurfaceBrush}"/><TextBlock x:Name="ProgressText" Text="Chưa bắt đầu." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock x:Name="OutputPathText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Border>
  <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8"><DockPanel><Button x:Name="CancelTaskButton" DockPanel.Dock="Left" Content="Hủy tác vụ" Click="OnCancelTask" Visibility="Collapsed" Style="{StaticResource DangerButton}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CloseButton" Content="Đóng" Click="OnClose"/><Button x:Name="ExportButton" Content="Chọn nơi lưu và xuất" Click="OnExport" Style="{StaticResource PrimaryButton}" IsEnabled="False"/></StackPanel><TextBlock Text="Chương đã xóa mềm không được đưa vào file." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></DockPanel></Border>
 </Grid>
</Window>
