<Window x:Class="QuickTranslator.AiEditor.Wpf.VanCacBatchPublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng hàng loạt lên Sắc Viện" Width="1100" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Closing="OnClosing" ResizeMode="CanResize">
 <DockPanel Margin="{StaticResource Inset.Window}">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Đăng hàng loạt lên Sắc Viện" Style="{StaticResource WindowTitle}"/>
   <TextBlock Style="{StaticResource WindowSubtitle}" TextWrapping="Wrap" Margin="0,4,0,8"
              Text="Tích các truyện cần đăng. Từng truyện được gửi lần lượt vào truyện đã liên kết trên website; truyện chưa liên kết được ghép theo tên hoặc tạo mới (bản nháp). Truyện đang dịch sẽ được bỏ qua."/>
   <DockPanel Margin="0,0,0,8">
    <Button x:Name="AccountButton" DockPanel.Dock="Right" Content="Đăng nhập…" Click="OnAccount"/>
    <TextBlock x:Name="AccountText" VerticalAlignment="Center" TextWrapping="Wrap"/>
   </DockPanel>
   <WrapPanel Margin="0,0,0,8">
    <Button Content="Chọn tất cả" Click="OnSelectAll"/>
    <Button Content="Chọn truyện đã liên kết" Click="OnSelectLinked"/>
    <Button Content="Bỏ chọn" Click="OnSelectNone"/>
    <CheckBox x:Name="OnlyNewInput" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"
              Content="Chỉ gửi chương chưa có trên web"
              ToolTip="Bỏ tích để gửi lại mọi chương: chương giống hệt báo “không đổi”, chương đã sửa được cập nhật."/>
    <CheckBox x:Name="AllowIncompleteInput" VerticalAlignment="Center" Margin="16,0,0,0"
              Content="Đăng cả chương chưa hoàn tất/cần kiểm tra"/>
   </WrapPanel>
   <WrapPanel Margin="0,0,0,8">
    <RadioButton x:Name="KeepDraftInput" GroupName="BatchStatus" VerticalAlignment="Center" Content="Chương mới là bản nháp"/>
    <RadioButton x:Name="PublishNowInput" GroupName="BatchStatus" VerticalAlignment="Center" Margin="16,0,0,0" Content="Xuất bản ngay"/>
    <StackPanel x:Name="AuthorPanel" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
     <TextBlock Text="Tác giả cho truyện mới:" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <ComboBox x:Name="AuthorInput" Width="220" DisplayMemberPath="Name" AutomationProperties.Name="Tác giả cho truyện mới"/>
    </StackPanel>
   </WrapPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <ProgressBar x:Name="BatchProgress" Height="7" Minimum="0" Maximum="1" Margin="0,0,0,8"
                Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource EditorSurfaceBrush}"/>
   <DockPanel>
    <WrapPanel DockPanel.Dock="Right">
     <Button x:Name="CancelButton" Content="Dừng" Click="OnCancel" Visibility="Collapsed"/>
     <Button x:Name="CloseButton" IsCancel="True" Content="Đóng" Click="OnClose"/>
     <Button x:Name="StartButton" Content="Đăng 0 truyện" Style="{StaticResource PrimaryButton}" Click="OnStart" IsEnabled="False"/>
    </WrapPanel>
    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </DockPanel>
  </StackPanel>
  <DataGrid x:Name="BookGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
            CanUserDeleteRows="False" SelectionMode="Single" AutomationProperties.Name="Truyện có thể đăng">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="Đăng" Width="54">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 AutomationProperties.Name="{Binding Title, StringFormat=Đăng {0}}"/>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Truyện" Binding="{Binding Title}" Width="2*" IsReadOnly="True"/>
    <DataGridTextColumn Header="Đã dịch" Binding="{Binding ChaptersText}" Width="110" IsReadOnly="True"/>
    <DataGridTextColumn Header="Trên web" Binding="{Binding WebText}" Width="1.4*" IsReadOnly="True"/>
    <DataGridTextColumn Header="Truyện đích" Binding="{Binding Target}" Width="1.6*" IsReadOnly="True"/>
    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Stage}" Width="2.4*" IsReadOnly="True">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
