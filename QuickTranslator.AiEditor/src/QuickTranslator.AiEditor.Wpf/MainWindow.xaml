<Window x:Class="QuickTranslator.AiEditor.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QuickTranslator AI Editor" Width="1440" Height="940" MinWidth="1080" MinHeight="720" Closing="OnWindowClosing" Closed="OnWindowClosed" PreviewKeyDown="OnWindowPreviewKeyDown">
 <DockPanel x:Name="ApplicationShell" Margin="12">
  <Menu DockPanel.Dock="Top" Margin="0,0,0,6">
   <MenuItem Header="_Tệp"><MenuItem Header="Dự án mới…" Click="OnNewProject"/><MenuItem Header="Mở dự án…" Click="OnOpenProject"/><MenuItem x:Name="RecentProjectsMenu" Header="Dự án gần đây" SubmenuOpened="OnRecentProjectsOpened"/><Separator/><MenuItem Header="Đóng dự án" Click="OnCloseProject"/><Separator/><MenuItem Header="Nhập tiến độ cũ…" Click="OnImportLegacyProject"/></MenuItem>
   <MenuItem Header="_Dự án"><MenuItem Header="Thư viện dự án…" Click="OnShowProjectLibrary"/><MenuItem Header="Thuộc tính…" Click="OnEditProjectProperties"/><MenuItem Header="Mở thư mục" Click="OnOpenProjectFolder"/><Separator/><MenuItem Header="Sao lưu ZIP…" Click="OnBackupProject"/><MenuItem Header="Khôi phục bản sao…" Click="OnRestoreProject"/></MenuItem>
  </Menu>
  <Border x:Name="GlobalToolbar" DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8"><WrapPanel>
   <TextBlock Text="QuickTranslator AI Editor" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,4,18,4"/><ComboBox x:Name="ProjectSwitcher" Width="260" DisplayMemberPath="Title" SelectionChanged="OnProjectSwitcherChanged" ToolTip="Chuyển dự án gần đây"/><Button Content="Thư viện" Click="OnShowProjectLibrary"/><Button x:Name="NewButton" Content="Chương mới" Click="OnNewChapter"/><Button x:Name="OpenButton" Content="Mở tiến độ cũ" Click="OnOpenProgress"/><Button x:Name="SaveButton" Content="Lưu tiến độ" Click="OnSaveProgress"/><TextBlock Text="Ollama offline · Bản sửa luôn được bảo vệ" Margin="14,4" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
  </WrapPanel></Border>
  <StackPanel x:Name="GlobalStatus" DockPanel.Dock="Bottom" Margin="0,8,0,0"><TextBlock x:Name="StatusText" Text="Nhập chương và bấm Dịch toàn chương." TextWrapping="Wrap" Margin="4"/><TextBlock x:Name="SavePathText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="4"/></StackPanel>
  <Border x:Name="ProjectSidebar" DockPanel.Dock="Left" Width="290" Visibility="Collapsed" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,10,0" Margin="0,0,10,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="ActiveProjectTitle" Text="Dự án" FontSize="18" FontWeight="SemiBold" Margin="4"/><TextBox x:Name="ChapterSearchInput" ToolTip="Tìm theo số hoặc tên chương" TextChanged="OnChapterSearchChanged"/><ComboBox x:Name="ChapterStateFilter" SelectionChanged="OnChapterSearchChanged"><ComboBoxItem Tag="All" IsSelected="True">Tất cả trạng thái</ComboBoxItem><ComboBoxItem Tag="Untranslated">Chưa dịch</ComboBoxItem><ComboBoxItem Tag="AwaitingReview">Chờ duyệt</ComboBoxItem><ComboBoxItem Tag="NeedsInspection">Cần kiểm tra</ComboBoxItem><ComboBoxItem Tag="Approved">Đã duyệt</ComboBoxItem><ComboBoxItem Tag="Error">Lỗi</ComboBoxItem></ComboBox><ComboBox x:Name="ProjectChapterSort" SelectionChanged="OnChapterSearchChanged"><ComboBoxItem Tag="Number" IsSelected="True">Sắp theo số chương</ComboBoxItem><ComboBoxItem Tag="Title">Sắp theo tên</ComboBoxItem><ComboBoxItem Tag="Updated">Mới sửa trước</ComboBoxItem></ComboBox><WrapPanel><Button Content="+ TXT" Click="OnAddChapterFromText"/><Button Content="Đổi tên" Click="OnRenameProjectChapter"/><Button Content="Nhân bản" Click="OnDuplicateProjectChapter"/><Button Content="Xóa" Click="OnDeleteProjectChapter" Style="{StaticResource DangerButton}"/></WrapPanel></StackPanel><StackPanel DockPanel.Dock="Bottom"><WrapPanel><Button Content="← Trước" Click="OnPreviousProjectChapter"/><Button Content="Sau →" Click="OnNextProjectChapter"/></WrapPanel><TextBlock x:Name="ProjectAutosaveStatus" Text="Đã lưu" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="4" TextWrapping="Wrap"/></StackPanel><ListBox x:Name="ProjectChapterList" DisplayMemberPath="Label" SelectionChanged="OnProjectChapterSelected"/></DockPanel></Border>
  <AdornerDecorator><TabControl x:Name="EditorTabs">
   <TabItem Header="Bản dịch chương"><Grid x:Name="ChapterWorkspace" Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel x:Name="ChapterModeBar" Margin="0,0,0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><RadioButton x:Name="ReaderModeButton" Content="Chế độ đọc" GroupName="ChapterMode" IsChecked="True" Checked="OnReaderModeChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,8" Margin="4"/><RadioButton x:Name="EditorModeButton" Content="Biên tập" GroupName="ChapterMode" Checked="OnReaderModeChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,8" Margin="4"/></StackPanel><TextBlock x:Name="ChapterModeHint" Text="Đọc liền mạch hoặc biên tập từng segment" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></DockPanel>
    <Grid x:Name="ReaderView" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel x:Name="ReaderToolbar"><WrapPanel><Button x:Name="ReaderAppearanceButton" Content="Aa  Kiểu đọc" Click="OnToggleReaderAppearance"/><Button Content="Tìm" Click="OnOpenReaderSearch" ToolTip="Ctrl+F"/><Button Content="Đánh dấu" Click="OnToggleBookmark"/><Button Content="Mở đoạn trong biên tập" Click="OnOpenReaderSelectionInEditor"/></WrapPanel><WrapPanel HorizontalAlignment="Right"><Button x:Name="FocusModeButton" Content="Tập trung" Click="OnToggleFocusMode"/><Button Content="Toàn màn hình" Click="OnToggleFullScreen" ToolTip="F11"/></WrapPanel></DockPanel>
     <Border x:Name="ReaderSearchPanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="6" Margin="4"><DockPanel><Button DockPanel.Dock="Right" Content="Đóng" Click="OnCloseReaderSearch"/><Button DockPanel.Dock="Right" Content="Tiếp" Click="OnFindNext"/><TextBox x:Name="ReaderSearchInput" KeyDown="OnReaderSearchKeyDown" ToolTip="Nhập từ cần tìm"/></DockPanel></Border>
     <Grid Grid.Row="2"><Border x:Name="ReaderBackground" Background="#F5EBD1" CornerRadius="8"><ScrollViewer x:Name="ReaderScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnReaderScrollChanged"><Border x:Name="ReaderPage" MaxWidth="760" HorizontalAlignment="Center" Padding="44,38" MinHeight="600"><StackPanel><TextBlock x:Name="ReaderTitle" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"/><RichTextBox x:Name="ReaderText" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="0" MouseDoubleClick="OnReaderTextDoubleClick" SelectionChanged="OnReaderSelectionChanged"/></StackPanel></Border></ScrollViewer></Border>
      <Popup x:Name="ReaderAppearancePopup" PlacementTarget="{Binding ElementName=ReaderAppearanceButton}" Placement="Bottom" StaysOpen="False"><Border x:Name="ReaderAppearancePanel" Style="{StaticResource Card}" Width="390" Background="White"><ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock Text="Tùy chỉnh đọc" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="Mật độ" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ReaderDensityInput" SelectionChanged="OnReaderDensityChanged"><ComboBoxItem Tag="Compact">Gọn</ComboBoxItem><ComboBoxItem Tag="Standard">Tiêu chuẩn</ComboBoxItem><ComboBoxItem Tag="Spacious">Thoáng</ComboBoxItem></ComboBox>
       <TextBlock Text="Màu nền" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ReaderThemeInput" SelectionChanged="OnReaderAppearanceChanged"><ComboBoxItem Tag="Warm">Ấm (mặc định)</ComboBoxItem><ComboBoxItem Tag="Light">Sáng</ComboBoxItem><ComboBoxItem Tag="Dark">Tối</ComboBoxItem><ComboBoxItem Tag="Vintage">Cổ điển</ComboBoxItem></ComboBox>
       <TextBlock Text="Phông chữ" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ReaderFontInput" IsEditable="True" SelectionChanged="OnReaderAppearanceChanged" LostKeyboardFocus="OnReaderAppearanceChanged"/>
       <TextBlock Text="Cỡ chữ" Style="{StaticResource FieldLabel}"/><Slider x:Name="ReaderFontSizeInput" Minimum="14" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnReaderAppearanceChanged"/>
       <TextBlock Text="Giãn dòng" Style="{StaticResource FieldLabel}"/><Slider x:Name="ReaderLineHeightInput" Minimum="1.3" Maximum="2.2" TickFrequency="0.05" ValueChanged="OnReaderAppearanceChanged"/>
       <TextBlock Text="Khoảng cách đoạn" Style="{StaticResource FieldLabel}"/><Slider x:Name="ReaderParagraphSpacingInput" Minimum="0" Maximum="36" TickFrequency="1" ValueChanged="OnReaderAppearanceChanged"/>
       <TextBlock Text="Lề trang" Style="{StaticResource FieldLabel}"/><Slider x:Name="ReaderPageMarginInput" Minimum="8" Maximum="100" TickFrequency="2" ValueChanged="OnReaderAppearanceChanged"/>
       <TextBlock Text="Chiều rộng trang" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ReaderWidthInput" SelectionChanged="OnReaderAppearanceChanged"><ComboBoxItem Tag="Narrow">Hẹp</ComboBoxItem><ComboBoxItem Tag="Comfortable">Vừa</ComboBoxItem><ComboBoxItem Tag="Wide">Rộng</ComboBoxItem></ComboBox>
       <CheckBox x:Name="ReaderCollapseBlankLinesInput" Content="Thu gọn dòng trống dư thừa khi hiển thị" IsChecked="True" Checked="OnReaderBlankLinesChanged" Unchecked="OnReaderBlankLinesChanged"/>
       <CheckBox x:Name="ReaderJustifyInput" Content="Căn đều hai lề" Checked="OnReaderAppearanceChanged" Unchecked="OnReaderAppearanceChanged"/><CheckBox x:Name="ReaderIndentInput" Content="Thụt đầu dòng" IsChecked="True" Checked="OnReaderAppearanceChanged" Unchecked="OnReaderAppearanceChanged"/>
      </StackPanel></ScrollViewer></Border></Popup>
     </Grid><DockPanel Grid.Row="3" Margin="4,8"><TextBlock x:Name="ReaderWarning" Foreground="#9A3412" TextWrapping="Wrap"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ReaderChineseIssuesButton" Content="Xử lý chữ Hán" Click="OnScanChineseText" Visibility="Collapsed" Padding="8,3"/><TextBlock x:Name="ReaderProgressText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></StackPanel></DockPanel>
    </Grid>
    <DockPanel x:Name="EditorView" Grid.Row="1" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top"><WrapPanel><TextBlock Text="Tiêu đề" VerticalAlignment="Center"/><TextBox x:Name="TitleInput" Width="340" Text="Chương mới"/><Button x:Name="PasteButton" Content="Dán chương" Click="OnPasteChapter"/><Button x:Name="ImportTextButton" Content="Nhập TXT" Click="OnImportText"/><Button x:Name="SplitButton" Content="Chỉ chia đoạn" Click="OnSplitChapter"/></WrapPanel><WrapPanel><Button x:Name="TranslateAllButton" Content="Dịch toàn chương" Click="OnTranslateAll" Style="{StaticResource PrimaryButton}"/><Button x:Name="PauseQueueButton" Content="Tạm dừng" Click="OnPauseQueue"/><Button x:Name="ResumeQueueButton" Content="Tiếp tục" Click="OnResumeQueue"/><Button x:Name="CancelQueueButton" Content="Hủy hàng đợi" Click="OnCancelQueue" Style="{StaticResource DangerButton}"/><Button x:Name="RetryErrorsButton" Content="Dịch lại đoạn lỗi" Click="OnRetryErrors"/><Button x:Name="BatchReplaceButton" Content="Tìm &amp; thay thế hàng loạt" Click="OnOpenBatchReplace"/><Button x:Name="ExportButton" Content="Xuất TXT UTF-8" Click="OnExportChapter"/></WrapPanel><ProgressBar x:Name="ChapterProgress" Height="10" Margin="4"/><TextBlock x:Name="QueueInfo" Margin="4" TextWrapping="Wrap"/><TextBlock x:Name="ChapterSummary" Margin="4"/><TextBlock x:Name="PronounReportSummary" Margin="4" TextWrapping="Wrap" Foreground="#7C2D12"/><ListBox x:Name="PronounResultsList" MaxHeight="100" DisplayMemberPath="Label" SelectionChanged="OnPronounResultSelected"/></StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions><DockPanel><TextBlock DockPanel.Dock="Top" Text="Nguyên văn chương" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ChapterInput" AcceptsReturn="True" AcceptsTab="True" TextChanged="OnChapterInputChanged" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16"/></DockPanel><GridSplitter Grid.Column="1" Width="6"/><DockPanel Grid.Column="2"><TextBlock DockPanel.Dock="Top" Text="Bản tiếng Việt theo từng khối" Style="{StaticResource FieldLabel}"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ChapterBlocksItems"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="4,2,4,8"><TextBlock Text="{Binding Label}" FontSize="12" Foreground="#64748B"/><TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Id}" AcceptsReturn="True" TextWrapping="Wrap" FontSize="16" MinHeight="42" BorderThickness="0,0,0,1"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Grid>
    </DockPanel>
   </Grid></TabItem>
   <TabItem Header="Phân đoạn &amp; chỉnh sửa"><DockPanel Margin="8">
    <WrapPanel DockPanel.Dock="Top"><Button x:Name="SplitSegmentButton" Content="Tách theo câu…" Click="OnSplitSegment"/><Button x:Name="MergeSegmentButton" Content="Gộp với đoạn kế" Click="OnMergeSegments"/><Button x:Name="MoveBoundaryButton" Content="Đổi ranh giới…" Click="OnMoveBoundary"/><Button x:Name="ArchiveButton" Content="Bản trước đổi đoạn" Click="OnShowSegmentationArchive"/><Button x:Name="RestoreStructureButton" Content="Khôi phục ranh giới" Click="OnRestoreStructure"/><Button x:Name="RestoreAllPanesButton" Content="Hiện đủ 4 ô" Click="OnRestoreTraditionalPanes"/><CheckBox x:Name="FollowQueueCheck" Content="Theo đoạn đang dịch" IsChecked="True"/></WrapPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ListBox x:Name="SegmentList" SelectionChanged="OnSegmentSelected"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Padding="4,6"/></DataTemplate></ListBox.ItemTemplate></ListBox><GridSplitter Grid.Column="1" Width="6"/>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <WrapPanel><Button x:Name="TranslateButton" Content="Dịch đoạn đang chọn" Click="OnTranslate" Style="{StaticResource PrimaryButton}"/><Button x:Name="CancelButton" Content="Hủy lần dịch" Click="OnCancelTranslation"/><Button x:Name="UseAiButton" Content="Dùng bản lịch sử làm nháp" Click="OnUseAiDraft"/><Button x:Name="ApproveButton" Content="Duyệt bản đang sửa" Click="OnApprove"/></WrapPanel>
      <Grid x:Name="TraditionalEditorGrid" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="TraditionalLeftColumn"/><ColumnDefinition x:Name="TraditionalVerticalSplitterColumn" Width="6"/><ColumnDefinition x:Name="TraditionalRightColumn"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="TraditionalTopRow"/><RowDefinition x:Name="TraditionalHorizontalSplitterRow" Height="6"/><RowDefinition x:Name="TraditionalBottomRow" Height="1.2*"/></Grid.RowDefinitions>
       <Border x:Name="ChinesePane" Style="{StaticResource Card}" Margin="2"><DockPanel><DockPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ẩn" Tag="Chinese" Click="OnHideTraditionalPane"/><Button Content="Phóng lớn" Tag="Chinese" Click="OnMaximizeTraditionalPane"/></StackPanel><TextBlock Text="Trung · nguyên văn" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox x:Name="SourceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsInactiveSelectionHighlightEnabled="False" SelectionChanged="OnTraditionalSelectionChanged" FontSize="16"/></DockPanel></Border>
       <GridSplitter x:Name="TraditionalVerticalSplitter" Grid.Column="1" Grid.RowSpan="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
       <Border x:Name="HanVietPane" Grid.Column="2" Style="{StaticResource Card}" Margin="2"><DockPanel><DockPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ẩn" Tag="HanViet" Click="OnHideTraditionalPane"/><Button Content="Phóng lớn" Tag="HanViet" Click="OnMaximizeTraditionalPane"/></StackPanel><TextBlock Text="Hán Việt · offline" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox x:Name="HanVietText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsInactiveSelectionHighlightEnabled="False" SelectionChanged="OnTraditionalSelectionChanged" FontSize="16"/></DockPanel></Border>
       <GridSplitter x:Name="TraditionalHorizontalSplitter" Grid.Row="1" Grid.ColumnSpan="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
       <Border x:Name="VietPhrasePane" Grid.Row="2" Style="{StaticResource Card}" Margin="2"><DockPanel><DockPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ẩn" Tag="VietPhrase" Click="OnHideTraditionalPane"/><Button Content="Phóng lớn" Tag="VietPhrase" Click="OnMaximizeTraditionalPane"/></StackPanel><TextBlock Text="VP đơn ý · offline" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox x:Name="VietPhraseText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsInactiveSelectionHighlightEnabled="False" SelectionChanged="OnTraditionalSelectionChanged" FontSize="16"/></DockPanel></Border>
       <Border x:Name="AiPane" Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Margin="2"><DockPanel><DockPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ẩn" Tag="Ai" Click="OnHideTraditionalPane"/><Button Content="Phóng lớn" Tag="Ai" Click="OnMaximizeTraditionalPane"/></StackPanel><TextBlock Text="AI dịch · chỉnh sửa độc lập" Style="{StaticResource FieldLabel}"/></DockPanel><ScrollViewer DockPanel.Dock="Bottom" MaxHeight="100"><TextBlock x:Name="ReviewInfo" TextWrapping="Wrap" Margin="4" Foreground="#92400E"/></ScrollViewer><StackPanel DockPanel.Dock="Top"><DockPanel><Button x:Name="PromptButton" DockPanel.Dock="Right" Content="Xem prompt / cấu hình" Click="OnShowPrompt"/><ComboBox x:Name="HistoryList" DisplayMemberPath="Label" SelectionChanged="OnHistorySelected"/></DockPanel><TextBox x:Name="AiText" Height="72" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Bản chỉnh sửa — AI không ghi đè" Style="{StaticResource FieldLabel}"/></StackPanel><TextBox x:Name="DraftText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnDraftChanged" FontSize="16"/></DockPanel></Border>
      </Grid>
     </Grid>
    </Grid>
   </DockPanel></TabItem>
   <TabItem Header="Thiết lập dịch"><Grid x:Name="SettingsPanel" Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <ListBox x:Name="SettingsNavigation" SelectionChanged="OnSettingsNavigationChanged" SelectedIndex="0" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Padding="6"><ListBoxItem Tag="Ai">AI &amp; hiệu năng</ListBoxItem><ListBoxItem Tag="Traditional">Data QuickTranslator</ListBoxItem><ListBoxItem Tag="Prompts">Prompt Presets</ListBoxItem><ListBoxItem Tag="Dictionary">Từ điển &amp; ngữ cảnh</ListBoxItem><ListBoxItem Tag="Characters">Nhân vật &amp; xưng hô</ListBoxItem><ListBoxItem Tag="Quality">Chất lượng bản dịch</ListBoxItem></ListBox>
    <Grid Grid.Column="1" Margin="16,0,0,0">
     <ScrollViewer x:Name="SettingsAiPanel"><StackPanel><TextBlock Text="AI &amp; hiệu năng" Style="{StaticResource SectionTitle}"/><TextBlock Text="Thiết lập được chốt khi bắt đầu hàng đợi; tiếp tục dùng snapshot cũ." Foreground="{StaticResource MutedBrush}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kết nối Ollama" FontWeight="SemiBold"/><WrapPanel><TextBox x:Name="ModelInput" Text="translategemma:12b" Width="250"/><Button Content="Kiểm tra kết nối" Click="OnTestOllamaConnection"/><TextBlock x:Name="OllamaConnectionStatus" VerticalAlignment="Center" Margin="8"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><WrapPanel><TextBlock Text="Temperature" VerticalAlignment="Center"/><TextBox x:Name="TemperatureInput" Text="0.1" Width="70"/><TextBlock Text="Context" VerticalAlignment="Center"/><TextBox x:Name="ContextInput" Text="4096" Width="90"/><TextBlock Text="Token đầu ra" VerticalAlignment="Center"/><TextBox x:Name="OutputTokensInput" Text="1536" Width="90"/><TextBlock Text="Timeout (giây)" VerticalAlignment="Center"/><TextBox x:Name="TimeoutInput" Text="300" Width="80"/></WrapPanel></Border><Border Style="{StaticResource Card}"><WrapPanel><TextBlock Text="Cỡ đoạn: tối thiểu" VerticalAlignment="Center"/><TextBox x:Name="MinimumInput" Text="300" Width="80"/><TextBlock Text="mục tiêu" VerticalAlignment="Center"/><TextBox x:Name="TargetInput" Text="400" Width="80"/><TextBlock Text="tối đa" VerticalAlignment="Center"/><TextBox x:Name="MaximumInput" Text="500" Width="80"/></WrapPanel></Border><Button Content="Lưu thiết lập" Click="OnSaveSettings" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="SettingsPromptPanel" Visibility="Collapsed"><StackPanel x:Name="PresetPanel"><TextBlock Text="Prompt Presets" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Preset đang dùng" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="PresetCombo" Width="420" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="OnPresetSelected"/><TextBlock x:Name="PresetSummaryText" Margin="4" TextWrapping="Wrap"/><WrapPanel><Button Content="Quản lý preset…" Click="OnOpenPresetManager" Style="{StaticResource PrimaryButton}"/><Button Content="Xem trước prompt" Click="OnPreviewPreset"/></WrapPanel><TextBox x:Name="PresetNameInput" Visibility="Collapsed"/><TextBox x:Name="PresetTemplateInput" Visibility="Collapsed" AcceptsReturn="True"/></StackPanel></Border></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="SettingsDictionaryPanel" Visibility="Collapsed"><StackPanel><TextBlock Text="Từ điển &amp; ngữ cảnh" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Thuật ngữ đã xác nhận" FontWeight="SemiBold"/><TextBlock Text="Mỗi mục gồm từ tiếng Trung và bản tiếng Việt đã xác nhận." Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="TermsInput" Visibility="Collapsed"/><DataGrid x:Name="GlossaryGrid" Height="280" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Tiếng Trung" Binding="{Binding Chinese}" Width="*"/><DataGridTextColumn Header="Tiếng Việt" Binding="{Binding Vietnamese}" Width="2*"/></DataGrid.Columns></DataGrid><WrapPanel><Button Content="Thêm" Click="OnAddGlossaryTerm" Style="{StaticResource PrimaryButton}"/><Button Content="Sửa" Click="OnEditGlossaryTerm"/><Button Content="Xóa" Click="OnDeleteGlossaryTerm" Style="{StaticResource DangerButton}"/><Button Content="Nhập TXT / JSON" Click="OnImportGlossary"/><Button Content="Xuất TXT" Click="OnExportGlossary"/><TextBlock x:Name="TermsCountText" VerticalAlignment="Center" Margin="8"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ngữ cảnh ngắn đã xác nhận" FontWeight="SemiBold"/><TextBox x:Name="ContextNotesInput" Height="150" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000" TextChanged="OnSettingsInputChanged"/><TextBlock x:Name="ContextCountText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border><Button Content="Lưu từ điển và ngữ cảnh" Click="OnSaveSettings" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/></StackPanel></ScrollViewer>
