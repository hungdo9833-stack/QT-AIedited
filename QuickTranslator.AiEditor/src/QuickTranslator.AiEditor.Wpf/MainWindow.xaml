                                                <RadioButton x:Name="ThemeDarkRadio" GroupName="ShellThemeChoice" Tag="Dark" Content="Tối" Style="{StaticResource ModeButton}" Checked="OnThemeChoiceChanged"/>
                                            </StackPanel>
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="Theo Windows dùng chế độ sáng/tối của Windows (Cài đặt › Cá nhân hóa › Màu) và tự đổi khi Windows đổi. Nút Light/Dark trên thanh đầu chọn thẳng Sáng hoặc Tối. Trang Đọc có bảng màu riêng trong Kiểu đọc."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- One save for every settings page, always in the same place. API key and GPU profiles keep their own buttons (stored separately). -->
                            <Border Grid.Row="1" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8" Margin="0,8,0,0">
                                <DockPanel>
                                    <Button x:Name="SettingsSaveButton" DockPanel.Dock="Right" Content="Lưu thiết lập" ui:ButtonIcon.Glyph="&#xE74E;" Click="OnSaveSettings" Style="{StaticResource PrimaryButton}" ToolTip="Lưu thiết lập dịch, từ điển, ngữ cảnh và hồ sơ nhân vật"/>
                                    <TextBlock x:Name="SettingsDirtyText" Text="Mọi thay đổi đã được lưu" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
          </DockPanel>
        </AdornerDecorator>
    </DockPanel>
</Window>
