<Window x:Class="QuickTranslator.AiEditor.Wpf.MainWindow" xmlns:ui="clr-namespace:QuickTranslator.AiEditor.Wpf" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QT Studio · Trung–Việt Translation Workspace" Width="1600" Height="950" MinWidth="900" MinHeight="520" Closing="OnWindowClosing" Closed="OnWindowClosed" PreviewKeyDown="OnWindowPreviewKeyDown" SizeChanged="OnShellSizeChanged" AllowDrop="True" PreviewDragOver="OnWindowPreviewDragOver" Drop="OnWindowDrop" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="ShellTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}" Padding="0">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel x:Name="ApplicationShell" LastChildFill="True">
        <Menu DockPanel.Dock="Top" Padding="8,2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_Tệp">
                <MenuItem Header="_Dự án mới…" Click="OnNewProject"/>
                <MenuItem Header="_Mở dự án…" Click="OnOpenProject"/>
                <MenuItem x:Name="RecentProjectsMenu" Header="Dự án _gần đây" SubmenuOpened="OnRecentProjectsOpened"/>
                <Separator/>
                <MenuItem Header="Đóng dự á_n" Click="OnCloseProject"/>
            </MenuItem>
            <MenuItem Header="_Dự án">
                <MenuItem Header="_Thư viện dự án…" Click="OnShowProjectLibrary"/>
                <MenuItem Header="Th_uộc tính…" Click="OnEditProjectProperties"/>
                <MenuItem Header="_Mở thư mục" Click="OnOpenProjectFolder"/>
            </MenuItem>
        </Menu>
        <Border x:Name="GlobalToolbar" DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
            <DockPanel>
                <StackPanel x:Name="BrandBlock" DockPanel.Dock="Left" Width="190">
                    <TextBlock Text="QT STUDIO" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                    <TextBlock Text="TRUNG–VIỆT EDITOR" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ShellQueueButton" Content="Hàng đợi · chưa chạy" Click="OnOpenQueueStatus" ToolTip="Mở Queue Progress"/>
                    <Button x:Name="ProjectSidebarToggleButton" Content="Ẩn mục lục" Click="OnToggleProjectSidebar" ToolTip="Ẩn/Hiện mục lục chương (Ctrl+B)"/>
                    <Button x:Name="InspectorToggleButton" Content="Ẩn Inspector" Click="OnToggleInspector" ToolTip="Ẩn/Hiện Inspector (Ctrl+Shift+I)"/>
                    <Button x:Name="ThemeToggleButton" Content="Light" ui:ButtonIcon.Glyph="&#xE793;" Click="OnToggleShellTheme" ToolTip="Chuyển sang giao diện này (Dark / Light)"/>
                    <Button x:Name="SaveButton" Content="Lưu" ui:ButtonIcon.Glyph="&#xE74E;" Click="OnSaveProgress" ToolTip="Lưu tiến độ và tài nguyên (Ctrl+S)"/>
                </StackPanel>
                <DockPanel>
                    <ComboBox x:Name="ProjectSwitcher" Width="300" HorizontalAlignment="Left" DisplayMemberPath="Title" SelectionChanged="OnProjectSwitcherChanged" ToolTip="Chuyển dự án gần đây" AutomationProperties.Name="Chuyển dự án gần đây" AutomationProperties.HelpText="Chuyển dự án gần đây"/>
                    <TextBlock x:Name="ShellChapterText" Text="Chưa mở chương" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Button x:Name="NewButton" Content="Chương mới" Click="OnNewChapter" Visibility="Collapsed"/>
                <Button x:Name="OpenButton" Content="Mở tiến độ cũ" Click="OnOpenProgress" Visibility="Collapsed"/>
            </DockPanel>
        </Border>
        <Border x:Name="QueueResumeBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tiếp tục dịch" Click="OnResumeProjectTranslationFromShell" Style="{StaticResource StateButton}"/>
                <TextBlock x:Name="QueueResumeSummaryText" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
        <Border x:Name="GlobalStatus" DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock x:Name="AutosaveStatusText" Text="✓ Đã tự lưu" TextWrapping="NoWrap" Foreground="{DynamicResource SuccessBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.LiveSetting="Polite"/>
                    <Button Style="{StaticResource StatusBarButton}" Click="OnOpenGpuManager" ToolTip="Nhấp để mở Quản lý GPU (Local + Remote)" AutomationProperties.Name="Backend dịch · mở Quản lý GPU"><TextBlock x:Name="OllamaBackendStatus" Text="Local · Ollama Local · translategemma:12b" TextWrapping="NoWrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/></Button>
                    <TextBlock x:Name="SavePathText" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0" MaxWidth="420"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Mở Project để bắt đầu biên dịch." Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
        <Border x:Name="ShellNavigation" DockPanel.Dock="Left" Width="176" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="4,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="8"/>
                    <Button x:Name="SettingsNavButton" Content="Thiết lập" ui:ButtonIcon.Glyph="&#xE713;" Tag="Settings" Click="OnShellNavigate" Style="{StaticResource NavigationButton}"/>
                    <Button x:Name="NavRailToggleButton" Content="«" Click="OnToggleNavRail" Style="{StaticResource NavigationButton}" HorizontalContentAlignment="Center" ToolTip="Thu gọn / Mở rộng thanh điều hướng" AutomationProperties.Name="Thu gọn hoặc mở rộng thanh điều hướng" AutomationProperties.HelpText="Thu gọn / Mở rộng thanh điều hướng"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="WORKSPACE" Margin="14,4,8,8" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                    <Button x:Name="TranslateNavButton" Content="Biên tập" ui:ButtonIcon.Glyph="&#xE8C1;" Tag="Translate" Click="OnShellNavigate" Style="{StaticResource NavigationButton}" ToolTip="Biên tập / Kiểm tra &amp; Duyệt (Ctrl+1 / Ctrl+2)"/>
                    <Button Content="Chương" ui:ButtonIcon.Glyph="&#xE8FD;" Tag="Chapters" Click="OnShellNavigate" Style="{StaticResource NavigationButton}" ToolTip="Quản lý chương"/>
                    <Button Content="Nhập TXT" ui:ButtonIcon.Glyph="&#xE8B5;" Tag="Import" Click="OnShellNavigate" Style="{StaticResource NavigationButton}" ToolTip="Nhập TXT nhiều chương"/>
                    <Button Content="Hàng đợi" ui:ButtonIcon.Glyph="&#xE9D5;" Tag="Queue" Click="OnShellNavigate" Style="{StaticResource NavigationButton}" ToolTip="Hàng đợi dịch nhiều chương"/>
                    <Button Content="Thư viện" ui:ButtonIcon.Glyph="&#xE8F1;" Tag="Library" Click="OnShellNavigate" Style="{StaticResource NavigationButton}" ToolTip="Thư viện Project"/>
                    <Button x:Name="PublishNavButton" Content="Xuất bản" ui:ButtonIcon.Glyph="&#xEDE1;" Tag="Publish" Click="OnShellNavigate" Style="{StaticResource NavigationButton}" ToolTip="Xuất bản toàn bộ truyện TXT / PDF"/>
                    <Button x:Name="ReaderNavButton" Content="Đọc" ui:ButtonIcon.Glyph="&#xE736;" Tag="Reader" Click="OnShellNavigate" Style="{StaticResource NavigationButton}" ToolTip="Chế độ đọc toàn chương"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="ProjectSidebar" DockPanel.Dock="Left" Width="290" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,10,0" Margin="0,0,10,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="SidebarChaptersTabButton" Content="Chương" Padding="7,3" Click="OnSwitchLeftPanelToChapters" ToolTip="Xem mục lục chương"/>
                            <Button x:Name="SidebarSegmentsTabButton" Content="Đoạn" Padding="7,3" Click="OnSwitchLeftPanelToSegments" ToolTip="Chuyển sang danh sách đoạn"/>
                        </StackPanel>
                        <TextBlock x:Name="ActiveProjectTitle" Text="Dự án" FontSize="18" FontWeight="SemiBold" Margin="4" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBox x:Name="ChapterSearchInput" ToolTip="Tìm theo số hoặc tên chương" TextChanged="OnChapterSearchChanged" AutomationProperties.Name="Tìm chương" AutomationProperties.HelpText="Tìm theo số hoặc tên chương"/>
                    <ComboBox x:Name="ChapterStateFilter" SelectionChanged="OnChapterSearchChanged" AutomationProperties.Name="Lọc trạng thái chương">
                        <ComboBoxItem Tag="All" IsSelected="True">Tất cả trạng thái</ComboBoxItem>
                        <ComboBoxItem Tag="Untranslated">Chưa dịch</ComboBoxItem>
                        <ComboBoxItem Tag="AwaitingReview">Chờ duyệt</ComboBoxItem>
                        <ComboBoxItem Tag="NeedsInspection">Cần kiểm tra</ComboBoxItem>
                        <ComboBoxItem Tag="Approved">Đã duyệt</ComboBoxItem>
                        <ComboBoxItem Tag="Error">Lỗi</ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="ProjectChapterSort" SelectionChanged="OnChapterSearchChanged" AutomationProperties.Name="Sắp xếp chương">
                        <ComboBoxItem Tag="Number" IsSelected="True">Sắp theo số chương</ComboBoxItem>
                        <ComboBoxItem Tag="Title">Sắp theo tên</ComboBoxItem>
                        <ComboBoxItem Tag="Updated">Mới sửa trước</ComboBoxItem>
                    </ComboBox>
                    <WrapPanel>
                        <Button Content="TXT" ui:ButtonIcon.Glyph="&#xE710;" Click="OnAddChapterFromText" ToolTip="Thêm chương từ tệp TXT"/>
                        <Button Content="Quản lý chương" Click="OnOpenChapterManager"/>
                        <Button Content="Đổi tên" Click="OnRenameProjectChapter"/>
                        <Button Content="Nhân bản" Click="OnDuplicateProjectChapter"/>
                        <Button Content="Xóa" Click="OnDeleteProjectChapter" Style="{StaticResource DangerButton}"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <WrapPanel>
                        <Button Content="← Trước" Click="OnPreviousProjectChapter" ToolTip="Chương trước (Alt+PageUp)"/>
                        <Button Content="Sau →" Click="OnNextProjectChapter" ToolTip="Chương sau (Alt+PageDown)"/>
                    </WrapPanel>
                    <TextBlock x:Name="ProjectAutosaveStatus" Text="Đã lưu" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="4" TextWrapping="Wrap"/>
                </StackPanel>
                <ListBox x:Name="ProjectChapterList" DisplayMemberPath="Label" SelectionChanged="OnProjectChapterSelected" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Danh sách chương"/>
            </DockPanel>
        </Border>
        <GridSplitter x:Name="ProjectSidebarSplitter" DockPanel.Dock="Left" Width="4" Background="{DynamicResource BorderBrush}" Visibility="Collapsed" DragCompleted="OnWorkspaceSplitterDragCompleted" AutomationProperties.Name="Đổi kích thước mục lục"/>
        <Border x:Name="TranslationInspector" DockPanel.Dock="Right" Width="300" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="×" Padding="7,2" Click="OnToggleInspector" ToolTip="Ẩn Inspector (Ctrl+Shift+I)" AutomationProperties.Name="Ẩn Inspector" AutomationProperties.HelpText="Ẩn Inspector (Ctrl+Shift+I)"/>
                    <StackPanel>
                        <TextBlock Text="INSPECTOR" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="InspectorSelectionText" Text="Chọn một segment" FontWeight="SemiBold" Margin="0,4,0,8" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <TabControl x:Name="InspectorTabs" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Từ điển">
                        <ScrollViewer>
                            <StackPanel>
                                <Border x:Name="InspectorLiveSelectionBorder" Visibility="Collapsed" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="TRA CỨU VÙNG ĐANG BÔI ĐEN" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock x:Name="InspectorLiveSelectionText" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                        <WrapPanel>
                                            <Button x:Name="InspectorQuickAddCharacterButton" Content="Nhân vật" ui:ButtonIcon.Glyph="&#xE710;" Click="OnInspectorQuickAddCharacter" Padding="8,4"/>
                                            <Button x:Name="InspectorQuickAddGlossaryButton" Content="Glossary" ui:ButtonIcon.Glyph="&#xE710;" Click="OnInspectorQuickAddGlossary" Padding="8,4"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Hán Việt / VietPhrase theo ngữ cảnh" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="InspectorDictionaryText" Text="Chưa chọn segment." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="Glossary khớp đoạn" Style="{StaticResource FieldLabel}"/>
                                <ItemsControl x:Name="InspectorGlossaryItems"/>
                                <Button Content="Mở từ điển &amp; ngữ cảnh" Tag="Dictionary" Click="OnOpenInspectorSettings"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Ngữ cảnh">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock x:Name="InspectorContextText" TextWrapping="Wrap"/>
                                <Button Content="Sửa ngữ cảnh" Tag="Dictionary" Click="OnOpenInspectorSettings"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Nhân vật">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock x:Name="InspectorConsistencyStatusText" Text="Chưa chọn segment." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="InspectorCharacterItems"/>
                                <WrapPanel Margin="0,6,0,4">
                                    <Button Content="Quản lý nhân vật" Tag="Characters" Click="OnOpenInspectorSettings"/>
                                    <Button x:Name="InspectorPreviewRulesButton" Content="Xem prompt khóa" Click="OnPreviewCharacters"/>
                                </WrapPanel>
                                <Separator Margin="0,6"/>
                                <TextBlock Text="Quét &amp; chuẩn hóa xưng hô tại chỗ" Style="{StaticResource FieldLabel}"/>
                                <WrapPanel>
                                    <Button x:Name="InspectorScanPronounsButton" Content="Quét xưng hô" Click="OnScanPronouns"/>
                                    <Button x:Name="InspectorApplyPronounsButton" Content="Áp dụng an toàn" Click="OnApplyPronouns"/>
                                    <Button x:Name="InspectorUndoPronounsButton" Content="Hoàn tác" Click="OnUndoPronouns"/>
                                </WrapPanel>
                                <TextBlock x:Name="InspectorPronounSummaryText" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="2,4"/>
                                <ListBox x:Name="InspectorPronounResultsList" MaxHeight="160" DisplayMemberPath="Label" SelectionChanged="OnPronounResultSelected" AutomationProperties.Name="Danh sách kết quả xưng hô"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
        <GridSplitter x:Name="InspectorSplitter" DockPanel.Dock="Right" Width="5" Background="{DynamicResource BorderBrush}" DragCompleted="OnWorkspaceSplitterDragCompleted" AutomationProperties.Name="Đổi kích thước Inspector"/>
        <AdornerDecorator>
          <DockPanel>
            <Border x:Name="EditorContextHeader" DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="650">
                        <TextBlock x:Name="EditorContextTitleText" Text="Chưa mở Project" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="EditorContentStateText" Text="Chưa có chương" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EditorProcessingStateText" Visibility="Collapsed" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="PrimaryActionButton" Content="Mở Project" Click="OnPrimaryAction" Style="{StaticResource PrimaryButton}" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="TranslateAllButton" Content="Dịch chương" ui:ButtonIcon.Glyph="&#xE768;" Click="OnTranslateAll" Style="{StaticResource StateButton}" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="PauseQueueButton" Content="Tạm dừng" ui:ButtonIcon.Glyph="&#xE769;" Click="OnPauseQueue" Style="{StaticResource StateButton}" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="ResumeQueueButton" Content="Tiếp tục" ui:ButtonIcon.Glyph="&#xE768;" Click="OnResumeQueue" Style="{StaticResource StateButton}" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="RetryErrorsButton" Content="Dịch lại lỗi" ui:ButtonIcon.Glyph="&#xE72C;" Click="OnRetryErrors" Style="{StaticResource StateButton}" ToolTip="Dịch lại các đoạn lỗi trong chương" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="EditSourceButton" Content="Sửa nguyên văn" ui:ButtonIcon.Glyph="&#xE70F;" Click="OnBeginSourceEdit" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="SaveSourceEditButton" Content="Lưu nguyên văn" Click="OnSaveSourceEdit" Style="{StaticResource StateButton}" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="CancelSourceEditButton" Content="Hủy sửa nguồn" Click="OnCancelSourceEdit" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="ApproveCurrentButton" Content="Duyệt đoạn" ui:ButtonIcon.Glyph="&#xE73E;" Click="OnApprove" ToolTip="Duyệt đoạn hiện tại" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="ApproveAllChapterButton" Content="Duyệt chương" Click="OnApproveAllSegments" ToolTip="Duyệt toàn bộ các đoạn đã có bản dịch" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="SecondaryActionButton1" Click="OnSecondaryAction" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="SecondaryActionButton2" Click="OnSecondaryAction" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="SecondaryActionButton3" Click="OnSecondaryAction" ToolTipService.ShowOnDisabled="True"/>
                        <ToggleButton x:Name="EditorActionOverflowToggle" Style="{StaticResource CommandOverflowToggle}" ToolTip="Thêm hành động" AutomationProperties.Name="Thêm hành động"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=EditorActionOverflowToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=EditorActionOverflowToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Margin="0,4,0,0" Padding="4" MinWidth="190" CornerRadius="6" BorderThickness="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}">
                                <Button x:Name="CancelQueueButton" Content="Hủy queue chương" ui:ButtonIcon.Glyph="&#xE71A;" Click="OnCancelQueue" Style="{StaticResource StateDangerButton}" ToolTipService.ShowOnDisabled="True"/>
                            </Border>
                        </Popup>
                    </WrapPanel>
                </DockPanel>
            </Border>
            <TabControl x:Name="EditorTabs" Style="{StaticResource ShellTabControl}" SelectedIndex="0">
                <TabItem Header="Biên tập">
                    <Grid x:Name="ChapterWorkspace" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel x:Name="ChapterModeBar" Margin="0,0,0,7">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <RadioButton x:Name="TwoPaneModeButton" Content="Hai ô" GroupName="EditorLayout" IsChecked="True" Checked="OnEditorLayoutChanged" Style="{StaticResource ModeButton}" ToolTip="Chế độ Hai ô · Lưới song ngữ đồng bộ (Ctrl+1)"/>
                                <RadioButton x:Name="FourPaneModeButton" Content="Bốn ô" GroupName="EditorLayout" Checked="OnEditorLayoutChanged" Style="{StaticResource ModeButton}" ToolTip="Chế độ Bốn ô · Trung / Hán Việt / VietPhrase / AI (Ctrl+2)"/>
                                <RadioButton x:Name="ReaderModeButton" Content="Đọc" GroupName="ChapterMode" Checked="OnReaderModeChanged" Visibility="Collapsed"/>
                                <RadioButton x:Name="EditorModeButton" Content="Biên tập" GroupName="ChapterMode" IsChecked="True" Checked="OnReaderModeChanged" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="ChapterModeHint" Text="Nguyên văn Trung · bản Việt đang biên tập" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </DockPanel>
                        <Grid x:Name="ReaderView" Grid.Row="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ReaderCatalogColumn" Width="270"/>
                                <ColumnDefinition x:Name="ReaderCatalogSplitterColumn" Width="5"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="ReaderCatalogPanel" Grid.RowSpan="4" Grid.Column="0" Background="{DynamicResource ReaderPanelBrush}" BorderBrush="{DynamicResource ReaderBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,8,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock x:Name="ReaderChapterCountText" DockPanel.Dock="Right" Foreground="{DynamicResource ReaderMutedBrush}"/>
                                            <TextBlock DockPanel.Dock="Left" Text="MỤC LỤC" FontWeight="SemiBold" Foreground="{DynamicResource ReaderMutedBrush}"/>
                                        </DockPanel>
                                        <TextBox x:Name="ReaderChapterSearchInput" ToolTip="Tìm theo số hoặc tên chương" TextChanged="OnReaderChapterSearchChanged" Margin="0,8,0,6" AutomationProperties.Name="Tìm chương trong mục lục đọc" AutomationProperties.HelpText="Tìm theo số hoặc tên chương"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="← Trước" Click="OnReaderPreviousChapter" ToolTip="Chương trước (Alt+PageUp)" Background="{DynamicResource ReaderPanelBrush}" Foreground="{DynamicResource ReaderTextBrush}" BorderBrush="{DynamicResource ReaderBorderBrush}"/>
                                        <Button Content="Sau →" Click="OnReaderNextChapter" ToolTip="Chương sau (Alt+PageDown)" Background="{DynamicResource ReaderPanelBrush}" Foreground="{DynamicResource ReaderTextBrush}" BorderBrush="{DynamicResource ReaderBorderBrush}"/>
                                    </StackPanel>
                                    <ListBox x:Name="ReaderChapterList" SelectionChanged="OnReaderChapterSelected" DisplayMemberPath="Label" Background="{DynamicResource ReaderPanelBrush}" Foreground="{DynamicResource ReaderTextBrush}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Danh sách chương để đọc">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="{x:Null}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ReaderTextBrush}"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
