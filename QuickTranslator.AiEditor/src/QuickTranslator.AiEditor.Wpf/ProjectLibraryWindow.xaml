<Window x:Class="QuickTranslator.AiEditor.Wpf.ProjectLibraryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QT Studio · Thư viện" Width="1180" Height="760" MinWidth="860" MinHeight="520"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="2,0,2,14"><Button DockPanel.Dock="Right" Content="＋ Tạo Project" Click="OnCreate" Style="{StaticResource PrimaryButton}"/><StackPanel><TextBlock Text="Thư viện truyện" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Mở nhanh Project, xem tiến độ và tiếp tục biên dịch" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8"><DockPanel><ComboBox x:Name="StatusFilter" DockPanel.Dock="Right" Width="190" SelectionChanged="OnFilterChanged"><ComboBoxItem Tag="All" IsSelected="True">Tất cả trạng thái</ComboBoxItem><ComboBoxItem Tag="Translating">Đang dịch</ComboBoxItem><ComboBoxItem Tag="Editing">Đang biên tập</ComboBoxItem><ComboBoxItem Tag="Completed">Hoàn thành</ComboBoxItem><ComboBoxItem Tag="Missing">Mất liên kết</ComboBoxItem></ComboBox><TextBox x:Name="SearchInput" ToolTip="Tìm tên truyện, tác giả hoặc đường dẫn" TextChanged="OnFilterChanged"/></DockPanel></Border>
  <ListBox x:Name="ProjectList" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnContinue" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
   <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><Border Width="342" Height="220" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SelectionBrush}" CornerRadius="7,0,0,7"><Grid><TextBlock Text="QT" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/></Grid></Border>
    <Grid Grid.Column="1" Margin="13"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="48"/><TextBlock Grid.Row="1" Text="{Binding Metadata}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,8" TextTrimming="CharacterEllipsis"/>
     <ProgressBar Grid.Row="2" Height="6" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource EditorSurfaceBrush}"/>
     <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="{Binding ProgressLabel}"/><TextBlock Text="{Binding CurrentChapterLabel}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock Text="{Binding Warning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
     <TextBlock Grid.Row="4" Text="{Binding UpdatedLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
    </Grid>
   </Grid></Border></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="LocateButton" Content="Tìm lại vị trí" Click="OnLocate"/><Button x:Name="RemoveButton" Content="Bỏ liên kết" Click="OnRemove"/><Button x:Name="DeleteButton" Content="Thùng rác" Click="OnDelete" Style="{StaticResource DangerButton}"/><Button x:Name="ContinueButton" Content="Tiếp tục biên dịch" Click="OnContinue" Style="{StaticResource PrimaryButton}"/></StackPanel><TextBlock x:Name="SelectionHint" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="Chọn một Project để tiếp tục." TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</Window>
