<Window x:Class="QuickTranslator.AiEditor.Wpf.ChapterTitleTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickTranslator.AiEditor.Wpf"
        Title="QT Studio · Dịch tiêu đề chương" Width="1120" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="4,0,4,10"><StackPanel><TextBlock Text="Dịch tiêu đề chương hàng loạt" Style="{StaticResource WindowTitle}"/><TextBlock x:Name="ScopeText" Style="{StaticResource WindowSubtitle}"/></StackPanel><TextBlock x:Name="ProgressText" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,9"><DockPanel>
   <WrapPanel DockPanel.Dock="Right"><Button x:Name="TranslateAllButton" Content="Dịch tất cả" ui:ButtonIcon.Glyph="&#xE768;" Click="OnTranslateAll"/><Button x:Name="RetryFailedButton" Content="Dịch lại mục lỗi" Click="OnRetryFailed"/><Button x:Name="RetrySelectedButton" Content="Dịch lại mục đã chọn" Click="OnRetrySelected"/><Button x:Name="CancelButton" Content="Hủy dịch" Click="OnCancelTranslation" IsEnabled="False"/></WrapPanel>
   <WrapPanel><TextBlock Text="Phương pháp" VerticalAlignment="Center"/><ComboBox x:Name="MethodInput" Width="220" SelectedIndex="0"><ComboBoxItem Tag="Ollama">AI Ollama đang chọn</ComboBoxItem><ComboBoxItem Tag="HanViet">Hán Việt</ComboBoxItem><ComboBoxItem Tag="VietPhrase">VietPhrase</ComboBoxItem><ComboBoxItem Tag="KeepChinese">Giữ nguyên tiếng Trung</ComboBoxItem></ComboBox><CheckBox x:Name="OverwriteProtectedCheck" Content="Cho phép thay tên Việt hiện có" VerticalAlignment="Center" Margin="12,4" ToolTip="Chỉ áp dụng sau preview và xác nhận; mặc định giữ tên Việt do người dùng sửa."/></WrapPanel>
  </DockPanel></Border>
  <DataGrid x:Name="TitleGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" CellEditEnding="OnCellEditEnding" SelectionChanged="OnSelectionChanged" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Danh sách tiêu đề chương">
   <DataGrid.Columns><DataGridTextColumn Header="Số" Binding="{Binding Number}" Width="75" IsReadOnly="True"/><DataGridTextColumn Header="Tiêu đề Trung" Binding="{Binding ChineseTitle}" Width="1.5*" IsReadOnly="True"/><DataGridTextColumn Header="Tên Việt hiện tại" Binding="{Binding ExistingVietnameseTitle}" Width="1.5*" IsReadOnly="True"/><DataGridTextColumn Header="Tên Việt đề xuất" Binding="{Binding VietnameseTitle, Mode=OneWay}" Width="2*"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="125" IsReadOnly="True"/><DataGridTextColumn Header="Chi tiết" Binding="{Binding Error}" Width="1.5*" IsReadOnly="True"/></DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,9,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ApplyButton" Content="Áp dụng tất cả" Style="{StaticResource PrimaryButton}" ui:ButtonIcon.Glyph="&#xE74E;" Click="OnApply"/><Button Content="Đóng" IsCancel="True"/></StackPanel><TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
 </Grid>
</Window>
