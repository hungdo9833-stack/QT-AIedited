<Window x:Class="QuickTranslator.AiEditor.Wpf.VanCacNovelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Truyện trên Sắc Viện" Width="1000" Height="650" MinWidth="660" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Closed="OnClosed">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Truyện trên Sắc Viện" Style="{StaticResource WindowTitle}"/>
   <TextBlock x:Name="AccountText" Margin="0,6,0,8" TextWrapping="Wrap"/>
   <WrapPanel>
    <Button x:Name="AccountButton" Content="Đăng nhập…" Click="OnAccount"/>
    <Button x:Name="ReloadButton" Content="Tải lại" Click="OnReload"/>
   </WrapPanel>
   <TextBlock x:Name="StatusText" Margin="0,8,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Height="5" Visibility="Collapsed" Margin="0,0,0,8"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
   <TextBlock x:Name="LinkedNovelText" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" Click="OnClose"/>
    <WrapPanel>
     <Button x:Name="LinkButton" Content="Liên kết với Project đang mở" IsEnabled="False" Click="OnLink"/>
     <Button x:Name="OpenWebButton" Content="Mở trên web" IsEnabled="False" Click="OnOpenWeb"/>
    </WrapPanel>
   </DockPanel>
  </StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Truyện của tài khoản" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
    <ListBox x:Name="NovelsList" SelectionChanged="OnNovelChanged" AutomationProperties.Name="Truyện của tài khoản" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
      <TextBlock Text="{Binding Novel.Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <DockPanel Grid.Column="2">
    <TextBlock DockPanel.Dock="Top" Text="Chương của truyện đã chọn" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
    <TextBlock x:Name="ChaptersStatusText" DockPanel.Dock="Top" Text="Chọn một truyện để xem chương." TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
    <ListBox x:Name="ChaptersList" AutomationProperties.Name="Chương trên Sắc Viện" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
      <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Status}" Margin="0,4,0,0"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
