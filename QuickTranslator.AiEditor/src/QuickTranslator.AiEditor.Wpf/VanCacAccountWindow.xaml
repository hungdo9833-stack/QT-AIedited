<Window x:Class="QuickTranslator.AiEditor.Wpf.VanCacAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tài khoản Sắc Viện" Width="500" SizeToContent="Height" MinWidth="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Closed="OnClosed">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="20" KeyboardNavigation.TabNavigation="Cycle">
   <TextBlock Text="Tài khoản Sắc Viện" Style="{StaticResource WindowTitle}" Margin="0,0,0,14"/>
   <StackPanel x:Name="SignInPanel">
    <Label Content="Địa chỉ website" Target="{Binding ElementName=WebsiteInput}"/>
    <TextBox x:Name="WebsiteInput" TabIndex="0" AutomationProperties.Name="Địa chỉ website"/>
    <Label Content="Email" Target="{Binding ElementName=EmailInput}"/>
    <TextBox x:Name="EmailInput" TabIndex="1" AutomationProperties.Name="Email"/>
    <Label Content="Mật khẩu" Target="{Binding ElementName=PasswordInput}"/>
    <PasswordBox x:Name="PasswordInput" TabIndex="2" AutomationProperties.Name="Mật khẩu"/>
   </StackPanel>
   <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">
    <TextBlock x:Name="DisplayNameText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="RolesText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="WebsiteText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="ExpiryText" Margin="0,8,0,0" TextWrapping="Wrap"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar x:Name="BusyProgress" Height="5" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
    <Button x:Name="SignInButton" Content="Đăng nhập" TabIndex="3" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSignIn"/>
    <Button x:Name="SignOutButton" Content="Đăng xuất" TabIndex="3" Click="OnSignOut" Visibility="Collapsed"/>
    <Button x:Name="CloseButton" Content="Đóng" TabIndex="4" IsCancel="True" Click="OnClose"/>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</Window>
