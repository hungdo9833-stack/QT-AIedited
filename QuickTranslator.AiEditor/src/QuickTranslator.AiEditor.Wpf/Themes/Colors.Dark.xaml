<!-- "Ink" Dark palette. Keys are the brush keys in Brushes.xaml; ThemeManager copies each Color into that brush.
     Text pairs are checked for WCAG AA: Text 14.3:1, Muted 7.6:1, Subtle 4.8:1 on PanelBrush; white on PrimaryBrush 5.2:1. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundBrush">#0F1115</Color>
    <Color x:Key="PanelBrush">#16191F</Color>
    <Color x:Key="SurfaceBrush">#16191F</Color>
    <Color x:Key="PanelAltBrush">#1C2027</Color>
    <Color x:Key="EditorSurfaceBrush">#12151A</Color>
    <Color x:Key="ControlBrush">#242933</Color>
    <Color x:Key="HoverBrush">#2C323D</Color>
    <Color x:Key="PressedBrush">#333A46</Color>
    <Color x:Key="TextBrush">#E6E9EE</Color>
    <Color x:Key="MutedBrush">#A3ABB8</Color>
    <Color x:Key="SubtleBrush">#7D8696</Color>
    <Color x:Key="BorderBrush">#2A2F38</Color>
    <Color x:Key="BorderStrongBrush">#3A414D</Color>
    <Color x:Key="PrimaryBrush">#2563EB</Color>
    <Color x:Key="PrimaryHoverBrush">#1D4ED8</Color>
    <Color x:Key="PrimaryPressedBrush">#1E40AF</Color>
    <Color x:Key="OnPrimaryBrush">#FFFFFF</Color>
    <Color x:Key="AccentTextBrush">#7AAEFF</Color>
    <Color x:Key="FocusBrush">#7AAEFF</Color>
    <Color x:Key="SelectionBrush">#1F3A66</Color>
    <Color x:Key="SuccessBrush">#56D364</Color>
    <Color x:Key="WarningBrush">#E3B341</Color>
    <Color x:Key="DangerBrush">#FF7B72</Color>
    <Color x:Key="SuccessSubtleBrush">#133A20</Color>
    <Color x:Key="WarningSubtleBrush">#3A2E12</Color>
    <Color x:Key="DangerSubtleBrush">#3D1A1A</Color>
    <Color x:Key="ScrollThumbBrush">#3A414D</Color>
    <Color x:Key="ScrollThumbHoverBrush">#4B5463</Color>
</ResourceDictionary>
