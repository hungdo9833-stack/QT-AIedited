<!-- Design tokens: the only place where type sizes, spacing, radii and control heights are numbers.
     XAML elsewhere refers to these keys (StaticResource) or to the text styles below; see docs/UI-DESIGN-SYSTEM.vi.md.
     Type ramp follows Fluent (Caption 12 · Body 14 · Subtitle · Title), tightened for a dense desktop editor. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Type ramp -->
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">16</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.Display">28</sys:Double>
    <sys:Double x:Key="FontSize.Icon">16</sys:Double>
    <!-- Story text (source/translation editors) and the Reader chapter title: content, not chrome. -->
    <sys:Double x:Key="FontSize.Content">16</sys:Double>
    <sys:Double x:Key="FontSize.ContentTitle">30</sys:Double>
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Spacing scale (4 px grid): XS 4 · S 8 · M 12 · L 16 · XL 24 -->
    <Thickness x:Key="Space.XS">4</Thickness>
    <Thickness x:Key="Space.S">8</Thickness>
    <Thickness x:Key="Space.M">12</Thickness>
    <Thickness x:Key="Space.L">16</Thickness>
    <Thickness x:Key="Space.XL">24</Thickness>
    <Thickness x:Key="Gap.Bottom.XS">0,0,0,4</Thickness>
    <Thickness x:Key="Gap.Bottom.S">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Bottom.M">0,0,0,12</Thickness>
    <Thickness x:Key="Gap.Right.S">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.Right.M">0,0,12,0</Thickness>
    <Thickness x:Key="Gap.Top.S">0,8,0,0</Thickness>
    <Thickness x:Key="Inset.Window">16</Thickness>
    <Thickness x:Key="Inset.Panel">12</Thickness>
    <Thickness x:Key="Inset.Bar">12,8</Thickness>
    <Thickness x:Key="Inset.Button">12,6</Thickness>
    <Thickness x:Key="Inset.ButtonCompact">8,4</Thickness>

    <!-- Shape -->
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Overlay">8</CornerRadius>
    <sys:Double x:Key="Size.ControlHeight">32</sys:Double>
    <sys:Double x:Key="Size.ControlHeightCompact">24</sys:Double>
    <sys:Double x:Key="Size.FocusRing">2</sys:Double>

    <!-- Text styles: use these instead of FontSize/FontWeight on a TextBlock. -->
    <Style x:Key="CaptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
    <Style x:Key="BodyText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/></Style>
    <Style x:Key="BodyStrongText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SubtitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style x:Key="TitleText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Display}"/><Setter Property="FontSize" Value="{StaticResource FontSize.Title}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="DisplayText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Display}"/><Setter Property="FontSize" Value="{StaticResource FontSize.Display}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <!-- Small all-caps label above a group (rail sections, panel headers). -->
    <Style x:Key="OverlineText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
</ResourceDictionary>
