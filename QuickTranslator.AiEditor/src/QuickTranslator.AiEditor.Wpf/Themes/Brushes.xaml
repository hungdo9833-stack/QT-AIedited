<!-- One shared brush per key, initialised to the Dark palette. ThemeManager recolors these instances in place; never freeze them. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1115"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#16191F"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#16191F"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#1C2027"/>
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#12151A"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#242933"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#2C323D"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#333A46"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E6E9EE"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A3ABB8"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#7D8696"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2F38"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A414D"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#7AAEFF"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#7AAEFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#1F3A66"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#56D364"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E3B341"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7B72"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#133A20"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#3A2E12"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#3D1A1A"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A414D"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4B5463"/>
</ResourceDictionary>
