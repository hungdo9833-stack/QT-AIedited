<Window x:Class="QuickTranslator.AiEditor.Wpf.ProjectTranslationQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QT Studio · Translation Queue" Width="1120" Height="760" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="4,0,4,10">
      <StackPanel>
        <TextBlock x:Name="HeadingText" Text="Queue Plan" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock x:Name="ProjectText" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
        <TextBlock x:Name="SummaryText" HorizontalAlignment="Right" FontWeight="SemiBold"/>
        <TextBlock Text="Dịch tuần tự · một chapter tại một thời điểm · checkpoint từng segment" Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Backend snapshot" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="BackendText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Model" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ModelText" FontWeight="SemiBold"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Prompt snapshot" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="PromptText" FontWeight="SemiBold"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="Resource revision" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ResourceText" FontWeight="SemiBold"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,10,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <ProgressBar x:Name="ChapterProgress" Height="10" Minimum="0" Maximum="100" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource EditorSurfaceBrush}"/>
        <TextBlock x:Name="CurrentText" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" Margin="12,0,0,0">
        <Button x:Name="StartButton" Content="Start" Style="{StaticResource PrimaryButton}" Click="OnStart"/>
        <Button x:Name="PauseButton" Content="Pause" Click="OnPause"/>
        <Button x:Name="ResumeButton" Content="Resume" Style="{StaticResource PrimaryButton}" Click="OnResume"/>
        <Button x:Name="CancelButton" Content="Hủy phần đang chờ" Click="OnCancel"/>
        <Button x:Name="RetryButton" Content="Retry chapter lỗi" Click="OnRetry"/>
      </WrapPanel>
    </Grid>
    <DataGrid x:Name="QueueGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
              BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource PanelAltBrush}"
              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
              ScrollViewer.CanContentScroll="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="55"/>
        <DataGridTextColumn Header="Số" Binding="{Binding Number}" Width="65"/>
        <DataGridTextColumn Header="Chapter" Binding="{Binding Title}" Width="2*"/>
        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="145"/>
        <DataGridTextColumn Header="Segment" Binding="{Binding SegmentLabel}" Width="105"/>
        <DataGridTextColumn Header="Lỗi" Binding="{Binding ErrorSegments}" Width="60"/>
        <DataGridTextColumn Header="Chi tiết" Binding="{Binding Error}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,8,0,0">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    </Border>
  </Grid>
</Window>
