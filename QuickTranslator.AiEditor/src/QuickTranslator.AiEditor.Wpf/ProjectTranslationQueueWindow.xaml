<Window x:Class="QuickTranslator.AiEditor.Wpf.ProjectTranslationQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:QuickTranslator.AiEditor.Wpf"
        Title="QT Studio · Hàng đợi dịch" Width="1120" Height="760" MinWidth="820" MinHeight="500" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  </Window.Resources>
  <Grid Margin="16" TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="4,0,4,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="HeadingText" Text="Tiến độ dịch" Style="{StaticResource WindowTitle}"/><TextBlock x:Name="ProjectText" Style="{StaticResource WindowSubtitle}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="StartButton" Content="Dịch" Style="{StaticResource PrimaryButton}" ui:ButtonIcon.Glyph="&#xE768;" Margin="4,0,0,0" Click="OnStart"/>
        <Button x:Name="ResumeButton" Content="Tiếp tục" Style="{StaticResource PrimaryButton}" ui:ButtonIcon.Glyph="&#xE768;" Margin="4,0,0,0" Click="OnResume"/>
        <Button x:Name="PauseButton" Content="Tạm dừng" ui:ButtonIcon.Glyph="&#xE769;" Margin="4,0,0,0" Click="OnPause" ToolTip="Tạm dừng sau khi AI xử lý xong đoạn hiện tại"/>
        <Border Width="1" Margin="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
        <Button x:Name="CancelButton" Content="Dừng nhanh" Style="{StaticResource DangerButton}" ui:ButtonIcon.Glyph="&#xE71A;" Margin="0" Click="OnCancel" ToolTip="Dừng request hiện tại; các đoạn đã lưu được giữ lại"/>
      </StackPanel>
    </Grid>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
      <Border Style="{StaticResource MetricCard}"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="20" Margin="0,0,8,0"/><TextBlock x:Name="TotalMetricText" Text="0" FontSize="22" FontWeight="SemiBold"/></StackPanel><TextBlock Text="TỔNG" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource SuccessBrush}"/><TextBlock x:Name="CompletedMetricText" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/></StackPanel><TextBlock Text="HOÀN THÀNH" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource IconText}" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextBrush}"/><TextBlock x:Name="RunningMetricText" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/></StackPanel><TextBlock Text="ĐANG DỊCH" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}" Margin="0"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" Style="{StaticResource IconText}" FontSize="20" Margin="0,0,8,0"/><TextBlock x:Name="RemainingMetricText" Text="0" FontSize="22" FontWeight="SemiBold"/></StackPanel><TextBlock Text="CÒN LẠI" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel></Border>
    </UniformGrid>
    <ItemsControl x:Name="WorkerCards" Grid.Row="2" Margin="0,0,0,8">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0"><StackPanel><DockPanel LastChildFill="False"><TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}"/></DockPanel><TextBlock Text="{Binding Model}" Foreground="{DynamicResource AccentTextBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CurrentChapterTitle, TargetNullValue=Đang chờ chương}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{DynamicResource MutedBrush}"><Run Text="{Binding HanCharactersPerMinute, StringFormat={}{0:N0}}"/><Run Text=" chữ Hán/phút · "/><Run Text="{Binding CompletedSegments}"/><Run Text="/"/><Run Text="{Binding TotalSegments}"/><Run Text=" đoạn"/></TextBlock></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Grid.Row="3" Margin="0,0,0,8">
      <DockPanel Margin="0,0,0,4"><TextBlock x:Name="CurrentText" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Margin="12,0,0,0" HorizontalAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
      <ProgressBar x:Name="ChapterProgress" AutomationProperties.Name="Tiến độ dịch chương hiện tại" Height="6" Minimum="0" Maximum="100" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource EditorSurfaceBrush}"/>
      <TextBlock Text="Có thể đóng cửa sổ này; hàng đợi vẫn lưu tiến độ sau từng đoạn." Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel>
    <DockPanel Grid.Row="4" Margin="0,0,0,8">
      <Expander x:Name="TechnicalExpander" Header="Chi tiết cấu hình &amp; chẩn đoán" Foreground="{DynamicResource MutedBrush}">
        <StackPanel><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GPU" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="BackendText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Model" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ModelText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Prompt" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="PromptText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Phiên tài nguyên" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ResourceText" FontWeight="SemiBold"/></StackPanel></Grid></Border><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,8,0"><StackPanel><TextBlock Text="Chapter đang chọn" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="SelectedDiagnosticText" Text="{Binding ElementName=QueueGrid, Path=SelectedItem.Error}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
      </Expander>
      <Expander x:Name="TroubleExpander" DockPanel.Dock="Right" Header="Xử lý sự cố" Foreground="{DynamicResource MutedBrush}"><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="RetryButton" Content="Thử lại chương lỗi" Margin="0" Click="OnRetry"/><Button x:Name="ReplanButton" Content="Kiểm tra nguồn thay đổi" Style="{StaticResource DangerButton}" Margin="4,0,0,0" Click="OnReplan"/><Button x:Name="RetryWorkerButton" Content="Kết nối lại GPU" Margin="4,0,0,0" Click="OnRetryWorker"/><Button x:Name="ReassignButton" Content="Chuyển phần chưa dịch" Margin="4,0,0,0" Click="OnReassignPending"/></StackPanel></Expander>
    </DockPanel>
    <DataGrid x:Name="QueueGrid" Grid.Row="5" Margin="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource PanelAltBrush}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" MouseDoubleClick="OnQueueGridDoubleClick" ToolTip="Nhấp đúp một chương đã xử lý để mở trong Editor">
      <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Order}" Width="55"/><DataGridTextColumn Header="Số" Binding="{Binding Number}" Width="65"/><DataGridTextColumn Header="Chương" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="GPU" Binding="{Binding Worker}" Width="125"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="155"/><DataGridTextColumn Header="Đoạn" Binding="{Binding SegmentLabel}" Width="105"/><DataGridTemplateColumn Header="Chi tiết" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Error}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0"><TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></Border>
  </Grid>
</Window>
