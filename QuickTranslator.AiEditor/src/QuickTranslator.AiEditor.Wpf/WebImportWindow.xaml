<Window x:Class="QuickTranslator.AiEditor.Wpf.WebImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập truyện từ web" Width="1020" Height="760" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Closing="OnWindowClosing">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12"/></Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}">
   <StackPanel>
    <TextBlock Text="Nhập truyện từ web" Style="{StaticResource WindowTitle}"/>
    <TextBlock Text="URL truyện / mục lục" Style="{StaticResource FieldLabel}"/>
    <DockPanel><Button x:Name="AnalyzeButton" DockPanel.Dock="Right" Content="Phân tích" Click="OnAnalyze"/><TextBox x:Name="UrlInput" AutomationProperties.Name="URL truyện hoặc mục lục"/></DockPanel>
    <WrapPanel Margin="0,4,0,0">
     <TextBlock Text="Nghỉ giữa các yêu cầu (giây)" VerticalAlignment="Center" Margin="4"/>
     <TextBox x:Name="DelayInput" Text="1.5" Width="72" AutomationProperties.Name="Thời gian nghỉ giữa các yêu cầu, tối thiểu 0,5 giây"/>
     <TextBlock Text="Tối thiểu 0,5 giây" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4"/>
    </WrapPanel>
    <CheckBox x:Name="KeepSiteOrderCheckBox" Content="Giữ đúng thứ tự mục lục (đánh số lại theo trang)" Margin="4,6,4,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10">
   <StackPanel>
    <TextBlock x:Name="BookTitleText" Text="Chưa phân tích truyện" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="ChapterCountText" Text="0 chương" Margin="0,4"/>
    <TextBlock x:Name="DetectionSummaryText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    <ScrollViewer MaxHeight="85" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="WarningsText" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/></ScrollViewer>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,10,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Phạm vi theo vị trí trong danh sách (từ 1)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
      <WrapPanel x:Name="RangePanel" IsEnabled="False">
       <TextBlock Text="Từ" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="FromInput" Width="65" Text="1" AutomationProperties.Name="Từ vị trí"/>
       <TextBlock Text="đến" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="ToInput" Width="65" Text="0" AutomationProperties.Name="Đến vị trí"/>
      </WrapPanel>
      <TextBlock Text="Danh sách chương" Style="{StaticResource FieldLabel}"/>
     </StackPanel>
     <ListBox x:Name="ChapterList" AutomationProperties.Name="Danh sách chương trên web" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="3"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource Card}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <DockPanel><Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="Xem trước" Click="OnPreview" IsEnabled="False"/><TextBlock Text="Chương đầu trong phạm vi" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/></DockPanel>
      <TextBlock x:Name="PreviewTitleText" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="PreviewPageCountText" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/>
     </StackPanel>
     <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Nội dung xem trước, 30 dòng đầu"/>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
   <DockPanel>
    <ProgressBar x:Name="BusyProgress" DockPanel.Dock="Top" Height="8" Visibility="Collapsed" Margin="4,0,4,8"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="CancelButton" Content="Hủy" Click="OnCancel" IsEnabled="False"/>
     <Button x:Name="CloseButton" Content="Đóng" Click="OnClose"/>
     <Button x:Name="DownloadButton" Content="Tải và nhập" Style="{StaticResource PrimaryButton}" Click="OnDownload" IsEnabled="False"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" Text="Phân tích URL, rồi xem trước nội dung trước khi tải." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4" AutomationProperties.LiveSetting="Polite"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
