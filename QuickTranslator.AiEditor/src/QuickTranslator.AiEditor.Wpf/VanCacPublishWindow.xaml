<Window x:Class="QuickTranslator.AiEditor.Wpf.VanCacPublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickTranslator.AiEditor.Wpf"
        Title="QT Studio · Đăng lên Văn Các" Width="760" Height="760" MinWidth="640" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Closing="OnClosing">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="16">
  <StackPanel Margin="2,0,2,14">
   <TextBlock Text="Đăng lên Văn Các" Style="{StaticResource WindowTitle}"/>
   <TextBlock x:Name="SubtitleText" Style="{StaticResource WindowSubtitle}" TextWrapping="Wrap"/>
  </StackPanel>

  <!-- 1. Kết nối -->
  <Border Style="{StaticResource Card}">
   <StackPanel>
    <TextBlock Text="1 · Kết nối website" Style="{StaticResource SectionTitle}"/>
    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Địa chỉ website" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="BaseUrlInput" AutomationProperties.Name="Địa chỉ website Văn Các"/>
      <TextBlock Text="Ví dụ https://ten-mien-cua-ban.com" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="3,2,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Mã kết nối (vcp_…)" Style="{StaticResource FieldLabel}"/>
      <PasswordBox x:Name="TokenInput" PasswordChar="●" AutomationProperties.Name="Mã kết nối Văn Các"/>
      <TextBlock x:Name="TokenStatusText" Text="Tạo mã ở website: Tài khoản → Kết nối QT Studio." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="3,2,0,0"/>
     </StackPanel>
    </Grid>
    <WrapPanel Margin="0,8,0,0">
     <Button x:Name="ConnectButton" Content="Lưu và kiểm tra kết nối" ui:ButtonIcon.Glyph="&#xE71B;" Click="OnConnect" Style="{StaticResource PrimaryButton}"/>
     <Button x:Name="ForgetTokenButton" Content="Xóa mã đã lưu" ui:ButtonIcon.Glyph="&#xE74D;" Click="OnForgetToken" Visibility="Collapsed"/>
    </WrapPanel>
    <TextBlock x:Name="ConnectionText" Margin="3,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </Border>

  <!-- 2. Truyện đích -->
  <Border Style="{StaticResource Card}">
   <StackPanel x:Name="NovelSection" IsEnabled="False">
    <TextBlock Text="2 · Truyện trên website" Style="{StaticResource SectionTitle}"/>
    <DockPanel Margin="0,6,0,0">
     <Button DockPanel.Dock="Right" x:Name="ReloadNovelsButton" Content="Tải lại" ui:ButtonIcon.Glyph="&#xE72C;" Click="OnReloadNovels"/>
     <ComboBox x:Name="NovelInput" SelectionChanged="OnNovelChanged" AutomationProperties.Name="Truyện đích trên website"/>
    </DockPanel>
    <TextBlock x:Name="PlanText" Margin="3,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
    <Button x:Name="ToggleCreateButton" Content="Tạo truyện mới trên website…" ui:ButtonIcon.Glyph="&#xE710;" Click="OnToggleCreate" HorizontalAlignment="Left" Margin="0,8,0,0"/>
    <StackPanel x:Name="CreatePanel" Visibility="Collapsed" Margin="0,8,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Tên truyện" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NewTitleInput" MaxLength="200" TextChanged="OnNewTitleChanged" AutomationProperties.Name="Tên truyện mới"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Đường dẫn (slug)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NewSlugInput" MaxLength="120" TextChanged="OnNewSlugChanged" AutomationProperties.Name="Đường dẫn truyện mới"/>
       <TextBlock Text="Chữ thường không dấu, số và dấu gạch nối." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="3,2,0,0"/></StackPanel>
     </Grid>
     <StackPanel x:Name="AuthorPanel" Visibility="Collapsed"><TextBlock Text="Tác giả (bút danh trên website)" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="AuthorInput" DisplayMemberPath="Name" AutomationProperties.Name="Tác giả của truyện mới"/></StackPanel>
     <TextBlock Text="Giới thiệu" Style="{StaticResource FieldLabel}"/>
     <TextBox x:Name="NewDescriptionInput" MaxLength="5000" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Giới thiệu truyện mới"/>
     <CheckBox x:Name="NewCompletedInput" Content="Truyện đã hoàn thành" Margin="3,6,0,0"/>
     <TextBlock Text="Truyện được tạo ở trạng thái bản nháp; xuất bản truyện trên website khi sẵn sàng." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="3,4,0,0"/>
     <Button x:Name="CreateNovelButton" Content="Tạo truyện trên website" ui:ButtonIcon.Glyph="&#xE710;" Click="OnCreateNovel" HorizontalAlignment="Left" Margin="0,8,0,0"/>
    </StackPanel>
   </StackPanel>
  </Border>

  <!-- 3. Đăng -->
  <Border Style="{StaticResource Card}">
   <StackPanel x:Name="PublishSection" IsEnabled="False">
    <TextBlock Text="3 · Đăng chương" Style="{StaticResource SectionTitle}"/>
    <RadioButton x:Name="KeepDraftInput" GroupName="Status" IsChecked="True" Margin="3,6,0,0"
                 Content="Bản nháp: chương mới là nháp, chương đã có giữ trạng thái; duyệt rồi xuất bản trên website"/>
    <RadioButton x:Name="PublishNowInput" GroupName="Status" Margin="3,4,0,0" Content="Xuất bản ngay: mọi chương gửi lên đều được xuất bản"/>
    <ProgressBar x:Name="PublishProgress" Height="7" Minimum="0" Maximum="1" Margin="4,14,4,6" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource EditorSurfaceBrush}"/>
    <TextBlock x:Name="ProgressText" Text="Chưa bắt đầu." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock x:Name="ReportText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <ListBox x:Name="LogList" Margin="0,8,0,0" Height="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Nhật ký đăng chương"/>
   </StackPanel>
  </Border>

  <Border Style="{StaticResource Card}" Padding="8">
   <DockPanel>
    <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="Dừng sau chương hiện tại" ui:ButtonIcon.Glyph="&#xE71A;" Click="OnCancel" Visibility="Collapsed" Style="{StaticResource DangerButton}"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="OpenSiteButton" Content="Mở trang quản lý" ui:ButtonIcon.Glyph="&#xE774;" Click="OnOpenSite" Visibility="Collapsed"/>
     <Button x:Name="StartButton" Content="Bắt đầu đăng" ui:ButtonIcon.Glyph="&#xE898;" Click="OnStart" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
     <Button x:Name="CloseButton" Content="Đóng" Click="OnClose"/>
    </StackPanel>
    <TextBlock Text="Dữ liệu Project không bị thay đổi." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
   </DockPanel>
  </Border>
 </StackPanel>
 </ScrollViewer>
</Window>
